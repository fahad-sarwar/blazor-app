@page "/basket"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@inject BasketService BasketService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

<h3 class ="mb-4">Basket</h3>

@if (!_loaded)
{
    <p>Loading basket...</p>
}
else if (BasketViewModel == null || !BasketViewModel.Items.Any())
{
    <p>Your basket is empty.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in BasketViewModel.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.Product.ImageURL))
                                {
                                    <img src="@item.Product.ImageURL" width="50" height="50" class="img-thumbnail" />
                                }
                                <span>@item.Product.Name</span>
                            </div>
                        </td>
                        <td class="text-end">@item.FormattedPrice()</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item, item.Quantity - 1)">–</button>
                                <span class="px-2">@item.Quantity</span>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item, item.Quantity + 1)">+</button>
                            </div>
                        </td>
                        <td class="text-end">@item.FormattedLineTotal()</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveItem(item)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-group-divider">
                <tr>
                    <td colspan="3" class="text-end fw-bold">VAT (20%)</td>
                    <td class="text-end">@BasketViewModel.FormattedVat()</td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Total</td>
                    <td class="text-end">@BasketViewModel.FormattedTotal()</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary btn-lg" @onclick="ProceedToCheckout">Proceed to Checkout</button>
        </div>
    </div>
}

@code {
    public BasketViewModel? BasketViewModel { get; set; }

    private string? _errorMessage;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBasketAsync();
        }
    }

    private async Task LoadBasketAsync()
    {
        BasketViewModel = await BasketService.GetBasket();

        if (BasketViewModel != null)
        {
            _errorMessage = null; 
        }
        else
        {
            _errorMessage = "Couldn't load basket.";
            BasketViewModel = new BasketViewModel();
        }

        _loaded = true;
        StateHasChanged();
    }

    private async Task UpdateQuantity(BasketItemViewModel item, int newQuantity)
    {
        if (newQuantity < 1)
        {
            await RemoveItem(item);
            return;
        }

        if (newQuantity == item.Quantity)
        {
            return;
        }

        var result = await BasketService.UpdateBasketQuantity(item.Id, newQuantity);

        if (result)
        {
            item.Quantity = newQuantity;
        }
        else
        {
            _errorMessage = "Failed to update quantity.";
            return;
        }

        StateHasChanged();
    }

    private async Task RemoveItem(BasketItemViewModel item)
    {
        var result = await BasketService.RemoveItemFromBasket(item.Id);

        if (result)
        {
            BasketViewModel!.Items.Remove(item);
        }
        else
        {
            _errorMessage = "Couldn't remove order item.";
        }

        StateHasChanged();
    }

    private async Task ProceedToCheckout()
    {
        var userInfo = CustomAuthenticationStateProvider.GetUserInfoDetails();

        if (userInfo == null)
        {
            var returnUrl = Uri.EscapeDataString("/checkout");
            Navigation.NavigateTo($"/account/register?returnUrl={returnUrl}");
        }
        else
        {
            Navigation.NavigateTo("/checkout");
        }
    }
}