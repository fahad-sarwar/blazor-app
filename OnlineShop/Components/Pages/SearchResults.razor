@page "/search-results/{SearchTerm}"

@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject ProductService ProductService
@rendermode InteractiveServer

<h3>Search Results</h3>

@if (!string.IsNullOrEmpty(SearchTerm))
{
    <p>Showing results for "<strong>@SearchTerm</strong>"</p>
}

@if (_products != null && _products.Count > 0)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="mb-0">Found <strong>@_totalProducts</strong> products</p>

        <div>
            <label for="sortSelect" class="me-2">Sort by:</label>
            <select id="sortSelect" class="form-select d-inline w-auto" @onchange="HandleSortChange">
                <option value="name-asc">Name (A-Z)</option>
                <option value="name-desc">Name (Z-A)</option>
                <option value="price-asc">Price (Low to High)</option>
                <option value="price-desc">Price (High to Low)</option>
            </select>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in _products)
        {
            <ProductSummaryItem Product="product" />
        }
    </div>

    @if (HasMore())
    {
        <div class="text-center mt-4">
            <button class="btn btn-outline-primary" @onclick="LoadMore">Load More</button>
        </div>
    }
}
else if (!string.IsNullOrEmpty(SearchTerm))
{
    <p>No products found.</p>
}
else
{
    <p>No search term provided.</p>
}

@code {
    [Parameter] public string? SearchTerm { get; set; }

    private List<ProductViewModel> _products = new();
    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalProducts = 0;
    private string _selectedSort = "name-asc";

    protected override async Task OnInitializedAsync()
    {
        Reset();
        await GetProducts();
    }

    private async Task HandleSortChange(ChangeEventArgs e)
    {
        _selectedSort = e.Value?.ToString() ?? "name-asc";
        Reset();
        await GetProducts();
    }

    private void Reset()
    {
        _products = new List<ProductViewModel>();
        _currentPage = 1;
        _pageSize = 9;
        _totalProducts = 0;
    }

    private async Task GetProducts()
    {
        var pagedProductResult = await ProductService.GetProducts(SearchTerm, _selectedSort, _currentPage, _pageSize);

        if(pagedProductResult != null)
        {
            _products.AddRange(pagedProductResult.Products);
            _totalProducts = pagedProductResult.TotalCount;
        }
        else
        {
            _products = new List<ProductViewModel>();
            _totalProducts = 0;
        }
    }

    private bool HasMore()
    {
        return _currentPage * _pageSize < _totalProducts;
    }

    private async Task LoadMore()
    {
        _currentPage += 1;
        await GetProducts();
    }
}