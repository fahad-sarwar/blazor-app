@page "/"

@using OnlineShopUI.Components.Layout
@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject ProductService ProductService
@layout MainLayout
@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<div id="carouselIndicators" class="carousel slide mb-3" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner" style="height: 400px;">
        <div class="carousel-item active">
            <img src="/images/CarouselImageOne.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
        <div class="carousel-item">
            <img src="/images/CarouselImageTwo.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
        <div class="carousel-item">
            <img src="/images/CarouselImageThree.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>


@if (_products == null)
{
    <p>Loading...</p>
}
else if (_products != null && _products.Count > 0)
{
    <h3>Sale Items</h3>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in _products)
        {
            <ProductSummaryItem Product="product" />
        }
    </div>
}

@code {
    private List<ProductViewModel>? _products;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var pagedProductResult = await ProductService.GetProductsAsync("name-asc", 1, 6);

        if (pagedProductResult != null)
        {
            _products = new List<ProductViewModel>(pagedProductResult.Products);
        }
        else
        {
            _products = new List<ProductViewModel>();
            _errorMessage = "Failed to load products.";
        }
    }
}