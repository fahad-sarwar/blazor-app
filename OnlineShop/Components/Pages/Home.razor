@page "/"

@using OnlineShopUI.Components.Layout
@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject ProductService ProductService
@layout MainLayout
@rendermode InteractiveServer

<CarouselBanner />

@if (_products == null)
{
    <p>Loading...</p>
}
else if (_products.Count > 0)
{
    <h3>Sale Items</h3>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in _products)
        {
            <ProductSummaryItem Product="product" />
        }
    </div>
}

@code {
    private List<ProductViewModel>? _products;

    protected override async Task OnInitializedAsync()
    {
        // get 6 products that are on sale
        var pagedProductResult = await ProductService.GetProducts("name-asc", 1, 6);

        if (pagedProductResult != null)
        {
            _products = new List<ProductViewModel>(pagedProductResult.Products);
        }
        else
        {
            _products = new List<ProductViewModel>();
        }
    }
}