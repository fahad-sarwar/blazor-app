@page "/order-details/{OrderId:int}"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Shared
@inject OrderService OrderService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

@if (_isUserAuthenticated)
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_order == null)
    {
        <div class="alert alert-warning">
            <p>Order not found, or you don't have permission to view this order.</p>
            <a href="/orders" class="btn btn-primary">Back to My Orders</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>#@_order.OrderNumber</h2>
            <a href="/orders" class="btn btn-primary">Back to Orders</a>
        </div>

        <OrderMilestones Order="@_order" />

        <OrderCustomerPaymentDetails Order="@_order" />

        <div class="col-md-12">
            <OrderSummary Order="@_order" />
        </div>

        <OrderTrackingUpdates Order="@_order" />
    }
}
else
{
    <LoginRegisterAlert ReturnUrl="%2Forder-details%2F@OrderId" />
}

@code {
    [Parameter] public int OrderId { get; set; }

    private bool _isUserAuthenticated;
    private OrderViewModel? _order;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isUserAuthenticated = await CustomAuthenticationStateProvider.IsUserAuthenticated();
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        _errorMessage = null;

        _order = await OrderService.GetOrderById(OrderId);

        if (_order == null)
        {
            _errorMessage = "Order not found or you don't have permission to view this order.";
        }
    }
}
