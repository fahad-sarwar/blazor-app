@page "/returns"
@rendermode InteractiveServer

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-5">
                <i class="bi bi-arrow-return-left me-3"></i>Returns & Refunds
            </h1>
        </div>
    </div>

    <!-- Return Policy Section -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Our Return Policy
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-3">
                                <i class="bi bi-calendar-check text-success me-3 fs-4"></i>
                                <div>
                                    <h6 class="fw-bold">30-Day Return Window</h6>
                                    <p class="text-muted mb-0">Return items within 30 days of delivery for a full refund.</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <i class="bi bi-box-seam text-info me-3 fs-4"></i>
                                <div>
                                    <h6 class="fw-bold">Original Condition</h6>
                                    <p class="text-muted mb-0">Items must be unused, unworn, and in original packaging.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-3">
                                <i class="bi bi-truck text-warning me-3 fs-4"></i>
                                <div>
                                    <h6 class="fw-bold">Free Return Shipping</h6>
                                    <p class="text-muted mb-0">We provide prepaid return labels for eligible returns.</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <i class="bi bi-credit-card text-success me-3 fs-4"></i>
                                <div>
                                    <h6 class="fw-bold">Quick Refunds</h6>
                                    <p class="text-muted mb-0">Refunds processed within 3-5 business days after we receive your return.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Return Process Steps -->
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="text-center mb-4">How to Return an Item</h3>
            <div class="row">
                <div class="col-md-3 text-center mb-4">
                    <div class="card h-100 border-0">
                        <div class="card-body">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <span class="fw-bold fs-4">1</span>
                            </div>
                            <h6 class="fw-bold">Find Your Order</h6>
                            <p class="text-muted small">Go to your orders page and select the order you want to return.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="card h-100 border-0">
                        <div class="card-body">
                            <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <span class="fw-bold fs-4">2</span>
                            </div>
                            <h6 class="fw-bold">Select Items</h6>
                            <p class="text-muted small">Choose which items you want to return and provide a reason.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="card h-100 border-0">
                        <div class="card-body">
                            <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <span class="fw-bold fs-4">3</span>
                            </div>
                            <h6 class="fw-bold">Print Label & Ship</h6>
                            <p class="text-muted small">We'll email you a prepaid return label to print and attach.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="card h-100 border-0">
                        <div class="card-body">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <span class="fw-bold fs-4">4</span>
                            </div>
                            <h6 class="fw-bold">Get Your Refund</h6>
                            <p class="text-muted small">Receive your refund within 3-5 business days of us receiving your return.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action -->
    <div class="row mb-5">
        <div class="col-lg-6 mx-auto text-center">
            <div class="card bg-light">
                <div class="card-body p-4">
                    <h5 class="card-title">Ready to Return Something?</h5>
                    <p class="card-text">Start by viewing your orders to select items for return.</p>
                    <a href="/orders" class="btn btn-primary btn-lg">
                        <i class="bi bi-list-ul me-2"></i>View My Orders
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <h3 class="text-center mb-4">Frequently Asked Questions</h3>
            <div class="accordion" id="returnsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            What items can't be returned?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion">
                        <div class="accordion-body">
                            <p>For hygiene and safety reasons, we cannot accept returns on:</p>
                            <ul>
                                <li>Underwear and intimate apparel</li>
                                <li>Personalized or customized items</li>
                                <li>Perishable goods</li>
                                <li>Items damaged by normal wear and tear</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            How long do refunds take?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion">
                        <div class="accordion-body">
                            <p>Once we receive your returned item, we'll process your refund within 3-5 business days. The time it takes for the refund to appear in your account depends on your payment method:</p>
                            <ul>
                                <li><strong>Credit/Debit Cards:</strong> 3-5 business days</li>
                                <li><strong>PayPal:</strong> 1-2 business days</li>
                                <li><strong>Bank Transfer:</strong> 5-7 business days</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            Can I exchange an item instead of returning it?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion">
                        <div class="accordion-body">
                            <p>We currently process returns for refunds only. If you'd like a different size or color, please:</p>
                            <ol>
                                <li>Return your original item for a full refund</li>
                                <li>Place a new order for the item you want</li>
                            </ol>
                            <p>This ensures you get the item you want as quickly as possible!</p>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            What if my item was damaged during shipping?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion">
                        <div class="accordion-body">
                            <p>If your item arrived damaged, we'll make it right immediately:</p>
                            <ul>
                                <li>Contact us within 48 hours of delivery</li>
                                <li>Provide photos of the damaged item and packaging</li>
                                <li>We'll send a replacement or full refund (your choice)</li>
                                <li>No need to return the damaged item</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card bg-light">
                <div class="card-body text-center p-4">
                    <h5 class="card-title">Need More Help?</h5>
                    <p class="card-text">Our customer service team is here to help with any questions about returns or refunds.</p>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a href="/contact" class="btn btn-outline-primary w-100">
                                <i class="bi bi-envelope me-2"></i>Email Support
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="tel:+1234567890" class="btn btn-outline-success w-100">
                                <i class="bi bi-telephone me-2"></i>Call Us
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="/orders" class="btn btn-outline-info w-100">
                                <i class="bi bi-list-ul me-2"></i>View Orders
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
