@page "/product/{Id:int}"

@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Layout
@inject IHttpClientFactory HttpClientFactory
@inject BasketService BasketService
@inject WishlistService WishlistService
@rendermode InteractiveServer

<h3>Product Details</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

@if (product == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card mb-4">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="@GetImageUrl(product)" class="img-fluid rounded-start" alt="@product.Name" />
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text"><strong>Price:</strong> £@product.Price.ToString("0.00")</p>

                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary" @onclick="AddToBasket">Add to Basket</button>

                        <AuthorizeView>
                            <Authorized>
                                <button class="btn @GetWishlistButtonClass()" @onclick="AddToWishlist" disabled="@isOnWishlist">
                                    <i class="@GetWishlistIconClass()"></i> Wishlist
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
            <ProductReviews ProductId="@Id" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public MainLayout? MainLayout { get; set; }
    [Parameter] public int Id { get; set; }

    public int ProductId { get; set; }
    private ProductViewModel? product;
    private string? ErrorMessage;
    private bool isOnWishlist;

    protected override async Task OnInitializedAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("Api");
        product = await httpClient.GetFromJsonAsync<ProductViewModel>($"api/products/{Id}");
        isOnWishlist = await WishlistService.IsOnWishlistAsync(product.Id);
    }

    private string GetImageUrl(ProductViewModel p) =>
        !string.IsNullOrWhiteSpace(p.ImageURL) ? p.ImageURL : "https://via.placeholder.com/300x200?text=No+Image";

    private async Task AddToBasket()
    {
        var result = await BasketService.AddToBasketAsync(product.Id, 1);

        if (result)
        {
            MainLayout?.ShowBasketPopup("Item added to basket!");
        }
        else
        {
            ErrorMessage = "Failed to add item to basket. Please try again.";
        }
    }

    private async Task AddToWishlist()
    {
        if (isOnWishlist) return;

        var success = await WishlistService.AddToWishlistAsync(Id);

        if (success)
        {
            isOnWishlist = true;
            MainLayout?.ShowBasketPopup("Item added to wishlist!");
        }
        else
        {
            ErrorMessage = "Failed to add item to wishlist. Please try again.";
        }
    }

    private string GetWishlistIconClass() => isOnWishlist ? "bi bi-heart-fill text-danger" : "bi bi-heart";
    private string GetWishlistButtonClass() => isOnWishlist ? "btn-danger" : "btn-outline-danger";
}