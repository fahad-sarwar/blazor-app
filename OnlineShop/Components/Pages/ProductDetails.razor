@page "/product/{Id:int}"

@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject BasketService BasketService
@inject ProductService ProductService
@inject WishlistService WishlistService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

@if (_product == null)
{
    <p>Loading product details...</p>
}
else
{
    <h3 class="mb-4">@_product.Name</h3>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card h-100">
                <img src="@_product.ImageURL" class="card-img-top" alt="@_product.Name" style="object-fit: cover;" />
            </div>
        </div>

        <div class="col-md-7 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="mb-4">
                        @if (_product.ForSale)
                        {
                            <div>
                                <h5><del>Was: @_product.FormattedPrice()</del></h5>
                                <h4 class="text-danger"><strong>Now: @_product.FormattedSalePrice()</strong></h4>
                            </div>
                        }
                        else
                        {
                            <h4>@_product.FormattedPrice()</h4>
                        }
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center">
                            <div class="me-2">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    @if (_product.AverageRating >= i)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else if (_product.AverageRating > i - 1)
                                    {
                                        <i class="bi bi-star-half text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                }
                            </div>
                            <span class="text-muted">(@_product.FormattedAverageRating())</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center">
                            <span class="@_product.StockStatusClass()">
                                @_product.StockStatus()
                                @if (_product.Stock > 0)
                                {
                                    <span class="text-muted"> (@_product.Stock available)</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="card-text">@_product.Description</p>
                    </div>

                    <div class="d-flex gap-2 mb-4">
                        <button class="btn btn-primary btn-lg" @onclick="AddToBasket" disabled="@(_product.Stock == 0)">
                            Add to Basket
                        </button>

                        @if (_isUserAuthenticated)
                        {
                            <button class="btn @GetWishlistButtonClass()" @onclick="AddToWishlist" disabled="@_isOnWishlist">
                                @(_isOnWishlist ? "In Wishlist" : "Add to Wishlist")
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger">@_errorMessage</div>
                    }

                    @if (_product.Stock == 0)
                    {
                        <div class="alert alert-warning">
                            This item is currently out of stock.
                        </div>
                    }

                    <ProductAttributes Product="@_product" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <ProductReviews ProductId="@Id" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductViewModel? _product;
    private string? _errorMessage;
    private bool _isOnWishlist;
    private bool _isUserAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged += OnAuthStateChanged;

        _isUserAuthenticated = await CustomAuthenticationStateProvider.IsUserAuthenticated();
        _product = await ProductService.GetProduct(Id);

        if (_product != null)
        {
            _isOnWishlist = await WishlistService.IsOnWishlist(_product.Id);
        }
    }

    public void Dispose()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged -= OnAuthStateChanged;
    }

    private async Task OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddToBasket()
    {
        if (_product == null || _product.Stock == 0)
        {
            return;
        }

        var success = await BasketService.AddToBasket(_product.Id, 1);

        if (success)
        {
            _errorMessage = null;

        }
        else
        {
            _errorMessage = "Failed to add item to basket.";
        }
    }

    private async Task AddToWishlist()
    {
        if (_isOnWishlist || _product == null)
        {
            return;
        }

        var success = await WishlistService.AddToWishlist(_product.Id);

        if (success)
        {
            _isOnWishlist = true;
            _errorMessage = null;
        }
        else
        {
            _errorMessage = "Couldn't add product to wishlist.";
        }
    }

    private string GetWishlistButtonClass()
    {
        return _isOnWishlist ? "btn-danger" : "btn-outline-danger";
    }
}