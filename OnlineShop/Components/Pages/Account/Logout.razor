@page "/account/logout"

@using OnlineShopUI.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="card-title mb-4">Sign Out</h3>

                    @if (isLoggingOut)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Signing out...</span>
                            </div>
                            <p class="mt-3">Signing you out...</p>
                        </div>
                    }
                    else
                    {
                        <p class="card-text mb-4">Are you sure you want to sign out of your account?</p>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <button class="btn btn-danger me-md-2" @onclick="HandleLogout" disabled="@isLoggingOut">
                                Sign Out
                            </button>
                            <button class="btn btn-secondary" @onclick="GoBack">
                                Cancel
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoggingOut = false;

    private async Task HandleLogout()
    {
        isLoggingOut = true;

        try
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            // AuthService handles the error and clears state
            Nav.NavigateTo("/");
        }
        finally
        {
            isLoggingOut = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}