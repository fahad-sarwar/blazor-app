@page "/account/logout"

@using OnlineShopUI.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<h3 class="mb-4">Sign Out</h3>

@if (_isLoggingOut)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Signing out...</span>
        </div>
        <p class="mt-3">Signing you out...</p>
    </div>
}
else
{
    <p class="card-text mb-4">Are you sure you want to sign out of your account?</p>

    <div>
        <button class="btn btn-danger me-md-2" @onclick="HandleLogout" disabled="@_isLoggingOut">
            Logout
        </button>
        <button class="btn btn-secondary" @onclick="GoBack">
            Cancel
        </button>
    </div>
}

@code {
    private bool _isLoggingOut = false;
    private string? _errorMessage;

    private async Task HandleLogout()
    {
        _isLoggingOut = true;

        var success = await AuthService.Logout();

        if (success)
        {
            _errorMessage = null;
            Nav.NavigateTo("/");            
        }
        else
        {
            _errorMessage = "There was an error signing you out.  Please try again.";
        }
        
        _isLoggingOut = false;
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}