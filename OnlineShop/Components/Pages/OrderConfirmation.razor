@page "/order-confirmation/{OrderId:int}"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Shared
@inject BasketCountService BasketCountService
@inject OrderService OrderService
@rendermode InteractiveServer

@if (_showSuccessMessage)
{
    <div class="alert alert-success">
        <p>Thank you for your order!</p>
        <p>Your order has been successfully placed.</p>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<h3>Order Confirmation</h3>

<AuthorizeView Context="authContext">
    <Authorized>
        @if (_loading)
        {
            <p>Loading order...</p>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">#@_order.OrderNumber</h5>
                    <strong>Status:</strong> @_order.Status
                    <br />
                    <strong>Placed on:</strong> @_order.GetFormattedCreatedAtDate()
                </div>
            </div>

            <div class="col-md-12">
                <OrderSummary Order="@_order" />
            </div>
        }

        <div class="mt-4">
            <a class="btn btn-primary me-2" href="/">Continue Shopping</a>
            <a class="btn btn-secondary" href="/order-details/@OrderId">View Order</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <LoginRegisterAlert ReturnUrl="%2F" />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int OrderId { get; set; }

    private OrderViewModel? _order;
    private string? _errorMessage;
    private bool _loading = true;
    private bool _showSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        _order = await OrderService.GetOrderById(OrderId);

        if (_order != null)
        {
            BasketCountService.SetCount(0);
            _showSuccessMessage = true;
        }
        else
        {
            _errorMessage = "Failed to load your order details.";
            _showSuccessMessage = false;
        }

        _loading = false;
    }
}
