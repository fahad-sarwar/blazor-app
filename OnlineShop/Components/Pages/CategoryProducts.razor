@page "/categories/{Id:int}"

@using Api.Models
@using OnlineShopUI.Components.Shared
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject CategoryService CategoryService
@inject ProductService ProductService
@rendermode InteractiveServer

@if (_category == null)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(_category?.Name))
{
    <p><strong>@_category.Name</strong></p>
}

@if (_products.Count > 0)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="mb-0">Found <strong>@_totalProducts</strong> products</p>

        <div>
            <label for="sortSelect" class="me-2">Sort by:</label>
            <select id="sortSelect" class="form-select d-inline w-auto" @onchange="HandleSortChange">
                <option value="name-asc">Name (A-Z)</option>
                <option value="name-desc">Name (Z-A)</option>
                <option value="price-asc">Price (Low to High)</option>
                <option value="price-desc">Price (High to Low)</option>
            </select>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in _products)
        {
            <ProductSummaryItem Product="product" />
        }
    </div>

    @if (HasMore())
    {
        <div class="text-center mt-4">
            <button class="btn btn-outline-primary" @onclick="LoadMore">Load More</button>
        </div>
    }
}
else if (_products.Count < 1)
{
    <p>No products found.</p>
}
else
{
    <p>Invalid category</p>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Category? _category;
    private List<ProductViewModel> _products = [];
    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalProducts = 0;
    private string _selectedSort = "name-asc";

    protected override async Task OnInitializedAsync()
    {
        Reset();
        await GetCategory();
        await GetProducts();
    }

    private async Task HandleSortChange(ChangeEventArgs e)
    {
        _selectedSort = e.Value?.ToString() ?? "name-asc";
        Reset();
        await GetProducts();
    }

    private void Reset()
    {
        _products = new List<ProductViewModel>();
        _currentPage = 1;
        _pageSize = 9;
        _totalProducts = 0;
    }

    private async Task GetCategory()
    {
        _category = await CategoryService.GetCategory(Id);

        if (_category == null)
        {
            _products = [];
            _totalProducts = 0;
        }
    }

    private async Task GetProducts()
    {
        var pagedProductResult = await ProductService.GetProducts(Id, _selectedSort, _currentPage, _pageSize);

        if (pagedProductResult != null)
        {
            _products.AddRange(pagedProductResult.Products);
            _totalProducts = pagedProductResult.TotalCount;
        }
        else
        {
            _products = new List<ProductViewModel>();
            _totalProducts = 0;
        }
    }

    private bool HasMore()
    {
        return _currentPage * _pageSize < _totalProducts;
    }

    private async Task LoadMore()
    {
        _currentPage += 1;
        await GetProducts();
    }
}