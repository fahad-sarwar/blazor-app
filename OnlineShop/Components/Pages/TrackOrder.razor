@page "/track-order"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Shared
@inject OrderService OrderService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container py-5">
    <AuthorizeView Context="authContext">
        <Authorized>
            <h2 class="text-center mb-4 pb-2 border-bottom border-3">Track Your Order</h2>

            <p class="text-center mb-4">Enter your order number to check the status of your delivery.</p>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                </div>
            }

            <!-- Tracking Form -->
            <div class="row justify-content-center mb-5">
                <div class="col-md-6">
                    <EditForm Model="@trackingModel" OnValidSubmit="TrackMyOrder" Context="editContext">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label for="orderNumber" class="form-label fw-semibold">
                                <i class="bi bi-box-seam me-2"></i>Order Number
                            </label>
                            <InputText id="orderNumber" class="form-control" @bind-Value="trackingModel.OrderNumber"
                                       placeholder="e.g. ORD0000123" />
                            <ValidationMessage For="@(() => trackingModel.OrderNumber)" class="text-danger" />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>Your order number starts with "ORD" followed by numbers
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isSearching">
                            @if (isSearching)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-2"></i>
                            }
                            Track Order
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row justify-content-center mb-5">
                <div class="col-md-8">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="card-title">Need help finding your order number?</h6>
                            <p class="card-text text-muted mb-3">
                                You can find your order number in the confirmation email we sent you, or view all your orders below.
                            </p>
                            <a href="/orders" class="btn btn-outline-primary">
                                <i class="bi bi-list-ul me-2"></i>View All My Orders
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="text-center mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="bi bi-headset display-4 text-primary mb-3"></i>
                                <h6>Need Help?</h6>
                                <p class="text-muted">Contact our support team for assistance.</p>
                                <a href="/contact" class="btn btn-outline-primary btn-sm">Contact Support</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="bi bi-question-circle display-4 text-info mb-3"></i>
                                <h6>Frequently Asked Questions</h6>
                                <p class="text-muted">Find answers to common delivery questions.</p>
                                <a href="/faqs" class="btn btn-outline-info btn-sm">View FAQs</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="bi bi-arrow-return-left display-4 text-warning mb-3"></i>
                                <h6>Delivery & Returns</h6>
                                <p class="text-muted">Learn about our delivery & returns policy.</p>
                                <a href="/delivery-and-returns" class="btn btn-outline-warning btn-sm">Delivery & Returns</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <LoginRegisterAlert ReturnUrl="%2Ftrack-order" />
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private TrackingModelViewModel trackingModel = new();
    private bool isSearching = false;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private async Task TrackMyOrder()
    {
        if (string.IsNullOrWhiteSpace(trackingModel.OrderNumber))
        {
            ErrorMessage = "Please enter an order number.";
            return;
        }

        try
        {
            isSearching = true;
            ErrorMessage = null;
            SuccessMessage = null;

            var result = await OrderService.GetOrderByOrderNumberAsync(trackingModel.OrderNumber.Trim().ToUpper());

            if (result?.Orders?.Any() == true)
            {
                var order = result.Orders.First();
                SuccessMessage = $"Order found! Redirecting to order details...";

                // Small delay to show success message
                await Task.Delay(1500);

                // Redirect to order details page
                Navigation.NavigateTo($"/order-details/{order.Id}");
            }
            else
            {
                ErrorMessage = $"Order '{trackingModel.OrderNumber}' not found. Please check your order number and try again.";
                trackingModel.OrderNumber = string.Empty; // Clear the input
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while searching for your order. Please try again.";
        }
        finally
        {
            isSearching = false;
        }
    }
}

