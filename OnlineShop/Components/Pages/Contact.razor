@page "/contact"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject MessageService MessageService
@rendermode InteractiveServer

<div class="container py-5">
    <h2 class="text-center mb-4">Contact Bob Kart</h2>

    <div class="row">
        <!-- Contact Form -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm rounded-3 p-4">
                <h4 class="mb-3">
                    <i class="bi bi-envelope me-2"></i>Send us a message
                </h4>

                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <EditForm Model="messageModel" OnValidSubmit="SendMessage">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i>Your Name
                        </label>
                        <InputText id="name" class="form-control" @bind-Value="messageModel.Name"
                                   placeholder="John Doe" />
                        <ValidationMessage For="@(() => messageModel.Name)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-1"></i>Your Email
                        </label>
                        <InputText id="email" class="form-control" @bind-Value="messageModel.Email"
                                   placeholder="you@example.com" type="email" />
                        <ValidationMessage For="@(() => messageModel.Email)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="subject" class="form-label fw-semibold">
                            <i class="bi bi-chat-text me-1"></i>Subject
                        </label>
                        <InputText id="subject" class="form-control" @bind-Value="messageModel.Subject"
                                   placeholder="Order Inquiry" />
                        <ValidationMessage For="@(() => messageModel.Subject)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label fw-semibold">
                            <i class="bi bi-chat-dots me-1"></i>Your Message
                        </label>
                        <InputTextArea id="message" class="form-control" @bind-Value="messageModel.Content"
                                       rows="5" placeholder="Write your message..." />
                        <ValidationMessage For="@(() => messageModel.Content)" class="text-danger" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-send me-2"></i>
                        }
                        Send Message
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="col-md-6">
            <div class="card shadow-sm rounded-3 p-4 mb-4">
                <h4 class="mb-3">
                    <i class="bi bi-geo-alt me-2"></i>Get in Touch
                </h4>
                <div class="mb-3">
                    <i class="bi bi-envelope text-primary me-2"></i>
                    <strong>Email:</strong>
                    <a href="mailto:support@bobkart.com" class="text-decoration-none">support@bobkart.com</a>
                </div>
                <div class="mb-3">
                    <i class="bi bi-telephone text-success me-2"></i>
                    <strong>Phone:</strong>
                    <a href="tel:+441234567890" class="text-decoration-none">+44 1234 567890</a>
                </div>
                <div class="mb-3">
                    <i class="bi bi-clock text-info me-2"></i>
                    <strong>Hours:</strong><br>
                    Monday - Friday: 9:00 AM - 6:00 PM<br>
                    Saturday: 10:00 AM - 4:00 PM<br>
                    Sunday: Closed
                </div>
                <div>
                    <i class="bi bi-building text-warning me-2"></i>
                    <strong>Address:</strong><br>
                    123 Market Street<br>
                    Rochdale, UK<br>
                    OL16 1AA
                </div>
            </div>

            <div class="card shadow-sm rounded-3 p-2">
                <iframe src="https://maps.google.com/maps?q=Rochdale%2C%20UK&t=&z=13&ie=UTF8&iwloc=&output=embed"
                        width="100%"
                        height="300"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        title="Bob Kart Location">
                </iframe>
            </div>

            <div class="card shadow-sm rounded-3 p-4 mt-4">
                <h5 class="mb-3">
                    <i class="bi bi-link-45deg me-2"></i>Quick Links
                </h5>
                <div class="row">
                    <div class="col-6">
                        <a href="/faqs" class="btn btn-outline-primary btn-sm w-100 mb-2">
                            <i class="bi bi-question-circle me-1"></i>FAQs
                        </a>
                        <a href="/delivery-and-returns" class="btn btn-outline-warning btn-sm w-100">
                            <i class="bi bi-arrow-return-left me-1"></i>Delivery & Returns
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/track-order" class="btn btn-outline-success btn-sm w-100 mb-2">
                            <i class="bi bi-truck me-1"></i>Track Order
                        </a>
                        <a href="/orders" class="btn btn-outline-info btn-sm w-100">
                            <i class="bi bi-list-ul me-1"></i>My Orders
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SendMessageViewModel messageModel = new();
    private bool isSubmitting;
    private string? SuccessMessage;
    private string? ErrorMessage;

    private async Task SendMessage()
    {
        try
        {
            isSubmitting = true;
            ErrorMessage = null;
            SuccessMessage = null;

            var success = await MessageService.SendMessageAsync(messageModel);

            if (success)
            {
                SuccessMessage = "Thank you for your message! We'll get back to you within 24 hours.";
                messageModel = new SendMessageViewModel();
            }
            else
            {
                ErrorMessage = "Failed to send your message. Please try again or contact us directly.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred. Please try again later.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}