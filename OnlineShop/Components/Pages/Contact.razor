@page "/contact"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject MessageService MessageService
@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<h3 class="mb-4">Contact Us</h3>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card rounded-3 p-4">
            <h4 class="mb-3">Send us a message</h4>
            <EditForm Model="_messageModel" OnValidSubmit="SendMessage">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="name" class="form-label fw-semibold">Your Name</label>
                    <InputText id="name" class="form-control" @bind-Value="_messageModel.Name" placeholder="John Doe" />
                    <ValidationMessage For="@(() => _messageModel.Name)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Your Email</label>
                    <InputText id="email" class="form-control" @bind-Value="_messageModel.Email" placeholder="you@example.com" type="email" />
                    <ValidationMessage For="@(() => _messageModel.Email)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="subject" class="form-label fw-semibold">Subject</label>
                    <InputText id="subject" class="form-control" @bind-Value="_messageModel.Subject" placeholder="Order Inquiry" />
                    <ValidationMessage For="@(() => _messageModel.Subject)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label fw-semibold">Your Message</label>
                    <InputTextArea id="message" class="form-control" @bind-Value="_messageModel.Content" rows="4" placeholder="Write your message..." />
                    <ValidationMessage For="@(() => _messageModel.Content)" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Send Message</button>
            </EditForm>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card rounded-3 p-4 mb-4">
            <h4 class="mb-3">Get in Touch</h4>
            <div class="mb-3">
                <strong>Email:</strong>
                <a href="mailto:support@bobkart.com" class="text-decoration-none">support@bobkart.com</a>
            </div>
            <div class="mb-3">
                <strong>Phone:</strong>
                <a href="tel:+441234567890" class="text-decoration-none">+44 1234 567890</a>
            </div>
            <div class="mb-3">
                <strong>Hours:</strong><br>
                Monday - Friday: 9:00 AM - 6:00 PM<br>
                Saturday: 10:00 AM - 4:00 PM<br>
                Sunday: Closed
            </div>
            <div>
                <strong>Address:</strong><br>
                123 Market Street<br>
                Rochdale, UK<br>
                OL16 1AA
            </div>
        </div>
    </div>
</div>

@code {
    private SendMessageViewModel _messageModel = new();
    private string? _successMessage;
    private string? _errorMessage;

    private async Task SendMessage()
    {
        _errorMessage = null;
        _successMessage = null;

        var success = await MessageService.SendMessage(_messageModel);

        if (success)
        {
            _successMessage = "Message sent!";
            _messageModel = new SendMessageViewModel();
        }
        else
        {
            _errorMessage = "Message failed to send.";
        }
    }
}