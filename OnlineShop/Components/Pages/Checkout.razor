@page "/checkout"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject BasketService BasketService
@inject CheckoutDummyDataService CheckoutDummyDataService
@inject CustomerService CustomerService
@inject OrderService OrderService
@inject ApiAuthenticationStateProvider ApiAuthenticationStateProvider

@if (_errorMessage != null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<h3 class="mb-4">Checkout</h3>

<AuthorizeView Context="authContext">
    <Authorized>

        @if (!_loaded)
        {
            <p>Loading basket...</p>
        }
        else if (_basket == null || !_basket.Items.Any())
        {
            <div class="alert alert-warning">Your basket is empty.</div>
        }
        else
        {
            <div class="row g-5">
                <div class="col-md-7">
                    <EditForm Model="@_checkoutModel" OnValidSubmit="SubmitOrder" Context="editContext">
                        <DataAnnotationsValidator />

                        <h5 class="mb-3">Customer Details</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="firstName" class="form-label fw-semibold">First Name</label>
                                <InputText id="firstName" class="form-control" @bind-Value="_checkoutModel.FirstName" disabled="true" />
                                <ValidationMessage For="@(() => _checkoutModel.FirstName)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="lastName" class="form-label fw-semibold">Last Name</label>
                                <InputText id="lastName" class="form-control" @bind-Value="_checkoutModel.LastName" disabled="true"  />
                                <ValidationMessage For="@(() => _checkoutModel.LastName)" class="text-danger" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label fw-semibold">Email</label>
                                <InputText id="email" class="form-control" @bind-Value="_checkoutModel.Email" disabled="true" />
                                <ValidationMessage For="@(() => _checkoutModel.Email)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="phoneNumber" class="form-label fw-semibold">Phone Number</label>
                                <InputText id="phoneNumber" class="form-control" @bind-Value="_checkoutModel.PhoneNumber" />
                                <ValidationMessage For="@(() => _checkoutModel.PhoneNumber)" class="text-danger" />
                            </div>
                        </div>

                        <h5 class="mb-3">Billing Address</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="billingAddressLine1" class="form-label fw-semibold">Address Line 1</label>
                                <InputText id="billingAddressLine1" class="form-control" @bind-Value="_checkoutModel.BillingAddressLineOne" />
                                <ValidationMessage For="@(() => _checkoutModel.BillingAddressLineOne)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="billingAddressLine2" class="form-label fw-semibold">Address Line 2</label>
                                <InputText id="billingAddressLine2" class="form-control" @bind-Value="_checkoutModel.BillingAddressLineTwo" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="billingTown" class="form-label fw-semibold">Town</label>
                                <InputText id="billingTown" class="form-control" @bind-Value="_checkoutModel.BillingTown" />
                                <ValidationMessage For="@(() => _checkoutModel.BillingTown)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="billingCounty" class="form-label fw-semibold">County</label>
                                <InputText id="billingCounty" class="form-control" @bind-Value="_checkoutModel.BillingCounty" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label for="billingPostcode" class="form-label fw-semibold">Postcode</label>
                                <InputText id="billingPostcode" class="form-control" @bind-Value="_checkoutModel.BillingPostCode" />
                                <ValidationMessage For="@(() => _checkoutModel.BillingPostCode)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="billingCountry" class="form-label fw-semibold">Country</label>
                                <InputText id="billingCountry" class="form-control" @bind-Value="_checkoutModel.BillingCountry" />
                                <ValidationMessage For="@(() => _checkoutModel.BillingCountry)" class="text-danger" />
                            </div>
                        </div>

                        <h5 class="mb-3">Shipping Address</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="shippingAddressLine1" class="form-label fw-semibold">Address Line 1</label>
                                <InputText id="shippingAddressLine1" class="form-control" @bind-Value="_checkoutModel.ShippingAddressLineOne" />
                                <ValidationMessage For="@(() => _checkoutModel.ShippingAddressLineOne)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="shippingAddressLine2" class="form-label fw-semibold">Address Line 2</label>
                                <InputText id="shippingAddressLine2" class="form-control" @bind-Value="_checkoutModel.ShippingAddressLineTwo" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="shippingTown" class="form-label fw-semibold">Town</label>
                                <InputText id="shippingTown" class="form-control" @bind-Value="_checkoutModel.ShippingTown" />
                                <ValidationMessage For="@(() => _checkoutModel.ShippingTown)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="shippingCounty" class="form-label fw-semibold">County</label>
                                <InputText id="shippingCounty" class="form-control" @bind-Value="_checkoutModel.ShippingCounty" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label for="shippingPostcode" class="form-label fw-semibold">Postcode</label>
                                <InputText id="shippingPostcode" class="form-control" @bind-Value="_checkoutModel.ShippingPostCode" />
                                <ValidationMessage For="@(() => _checkoutModel.ShippingPostCode)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="billingCountry" class="form-label fw-semibold">Country</label>
                                <InputText id="billingCountry" class="form-control" @bind-Value="_checkoutModel.ShippingCountry" />
                                <ValidationMessage For="@(() => _checkoutModel.ShippingCountry)" class="text-danger" />
                            </div>
                        </div>

                        <h5 class="mb-3">Payment Details</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="cardNumber" class="form-label fw-semibold">Card Number</label>
                                <InputText id="cardNumber" class="form-control" @bind-Value="_checkoutModel.CardNumber" />
                                <ValidationMessage For="@(() => _checkoutModel.CardNumber)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="cardName" class="form-label fw-semibold">Cardholder Name</label>
                                <InputText id="cardName" class="form-control" @bind-Value="_checkoutModel.CardName" />
                                <ValidationMessage For="@(() => _checkoutModel.CardName)" class="text-danger" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label for="expiry" class="form-label fw-semibold">Expiry</label>
                                <InputText id="expiry" class="form-control" @bind-Value="_checkoutModel.Expiry" placeholder="MM/YY" />
                                <ValidationMessage For="@(() => _checkoutModel.Expiry)" class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="cvv" class="form-label fw-semibold">CVV</label>
                                <InputText id="cvv" class="form-control" @bind-Value="_checkoutModel.CVV" placeholder="e.g. 887"/>
                                <ValidationMessage For="@(() => _checkoutModel.CVV)" class="text-danger" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <button type="submit" class="btn btn-success mt-3">Place Order</button>
                                <a class="btn btn-outline-primary mt-3" href="/basket">Back</a>
                            </div>
                        </div>
                    </EditForm>
                </div>

                <div class="col-md-5">
                    <BasketSummary Basket="@_basket" />
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <LoginRegisterAlert ReturnUrl="%2Fcheckout" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private BasketViewModel? _basket;
    private bool _loaded;
    private string? _errorMessage;

    private CheckoutViewModel _checkoutModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBasketAsync();
        await CreateDummyCheckoutModel();
    }

    private async Task CreateDummyCheckoutModel()
    {
        var authState = await ApiAuthenticationStateProvider.GetAuthenticationStateAsync();
        _checkoutModel = await CheckoutDummyDataService.GetDummyCheckoutModel(authState.User, CustomerService);
    }

    private async Task LoadBasketAsync()
    {
        _basket = await BasketService.GetBasket();

        if (_basket != null)
        {
            _errorMessage = null;
        }
        else
        {
            _errorMessage = "Failed to load basket.";
            _basket = new BasketViewModel();
        }

        _loaded = true;
        StateHasChanged();
    }

    private async Task SubmitOrder()
    {
        var createdOrder = await OrderService.CreateOrder(_checkoutModel, _basket);

        if (createdOrder != null)
        {
            Navigation.NavigateTo($"/order-confirmation/{createdOrder.Id}");
        }
        else
        {
            _errorMessage = "Failed to place order.";
        }
    }
}