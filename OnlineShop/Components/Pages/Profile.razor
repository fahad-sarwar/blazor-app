@page "/profile"

@using Api.Models.DTOs
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@inject AuthService AuthService
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (_isUserAuthenticated)
{
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <h3 class="mb-4">My Profile</h3>

    @if (_updateCustomer != null)
    {
        <EditForm Model="_updateCustomer" OnValidSubmit="HandleSubmit" Context="editContext">
            <DataAnnotationsValidator />

            <h5 class="mb-3">Personal Information</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="firstName" class="form-label fw-semibold">First Name</label>
                    <InputText id="firstName" class="form-control" @bind-Value="_updateCustomer.FirstName" />
                    <ValidationMessage For="@(() => _updateCustomer.FirstName)" class="text-danger" />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="lastName" class="form-label fw-semibold">Last Name</label>
                    <InputText id="lastName" class="form-control" @bind-Value="_updateCustomer.LastName" />
                    <ValidationMessage For="@(() => _updateCustomer.LastName)" class="text-danger" />
                </div>
            </div>

            <div class="mb-4">
                <label for="phoneNumber" class="form-label fw-semibold">Phone Number</label>
                <InputText id="phoneNumber" class="form-control" @bind-Value="_updateCustomer.PhoneNumber" placeholder="Enter your phone number" />
                <ValidationMessage For="@(() => _updateCustomer.PhoneNumber)" class="text-danger" />
            </div>

            <h5 class="mb-3">Shipping Address</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="shippingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                    <InputText id="shippingAddressLineOne" class="form-control" @bind-Value="_updateCustomer.ShippingAddressLineOne" />
                    <ValidationMessage For="@(() => _updateCustomer.ShippingAddressLineOne)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="shippingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                    <InputText id="shippingAddressLineTwo" class="form-control" @bind-Value="_updateCustomer.ShippingAddressLineTwo" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="shippingTown" class="form-label fw-semibold">Town</label>
                    <InputText id="shippingTown" class="form-control" @bind-Value="_updateCustomer.ShippingTown" />
                    <ValidationMessage For="@(() => _updateCustomer.ShippingTown)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="shippingCounty" class="form-label fw-semibold">County</label>
                    <InputText id="shippingCounty" class="form-control" @bind-Value="_updateCustomer.ShippingCounty" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="shippingPostCode" class="form-label fw-semibold">Postcode</label>
                    <InputText id="shippingPostCode" class="form-control" @bind-Value="_updateCustomer.ShippingPostCode" />
                    <ValidationMessage For="@(() => _updateCustomer.ShippingPostCode)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="shippingCountry" class="form-label fw-semibold">Country</label>
                    <InputText id="shippingCountry" class="form-control" @bind-Value="_updateCustomer.ShippingCountry" />
                    <ValidationMessage For="@(() => _updateCustomer.ShippingCountry)" class="text-danger" />
                </div>
            </div>

            <h5 class="mb-3">Billing Address</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="billingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                    <InputText id="billingAddressLineOne" class="form-control" @bind-Value="_updateCustomer.BillingAddressLineOne" />
                    <ValidationMessage For="@(() => _updateCustomer.BillingAddressLineOne)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="billingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                    <InputText id="billingAddressLineTwo" class="form-control" @bind-Value="_updateCustomer.BillingAddressLineTwo" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="billingTown" class="form-label fw-semibold">Town</label>
                    <InputText id="billingTown" class="form-control" @bind-Value="_updateCustomer.BillingTown" />
                    <ValidationMessage For="@(() => _updateCustomer.BillingTown)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="billingCounty" class="form-label fw-semibold">County</label>
                    <InputText id="billingCounty" class="form-control" @bind-Value="_updateCustomer.BillingCounty" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="billingPostCode" class="form-label fw-semibold">Postcode</label>
                    <InputText id="billingPostCode" class="form-control" @bind-Value="_updateCustomer.BillingPostCode" />
                    <ValidationMessage For="@(() => _updateCustomer.BillingPostCode)" class="text-danger" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="billingCountry" class="form-label fw-semibold">Country</label>
                    <InputText id="billingCountry" class="form-control" @bind-Value="_updateCustomer.BillingCountry" />
                    <ValidationMessage For="@(() => _updateCustomer.BillingCountry)" class="text-danger" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success" disabled="@_isSubmitting">
                    Update Profile
                </button>

                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </EditForm>
    }
}
else
{
    <LoginRegisterAlert ReturnUrl="%2Fprofile" />
}

@code {
    private UpdateCustomerDTO? _updateCustomer;
    private bool _isSubmitting = false;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _isUserAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        _isUserAuthenticated = await CustomAuthenticationStateProvider.IsUserAuthenticated();
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        var customer = await CustomerService.GetCustomer();

        if (customer != null)
        {
            _updateCustomer = new UpdateCustomerDTO
                {
                    Id = customer.Id,
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    PhoneNumber = customer.PhoneNumber,
                    ShippingAddressLineOne = customer.ShippingAddress?.AddressLineOne ?? string.Empty,
                    ShippingAddressLineTwo = customer.ShippingAddress?.AddressLineTwo ?? string.Empty,
                    ShippingTown = customer.ShippingAddress?.Town ?? string.Empty,
                    ShippingCounty = customer.ShippingAddress?.County ?? string.Empty,
                    ShippingPostCode = customer.ShippingAddress?.PostCode ?? string.Empty,
                    ShippingCountry = customer.ShippingAddress?.Country ?? "UK",
                    BillingAddressLineOne = customer.BillingAddress?.AddressLineOne ?? string.Empty,
                    BillingAddressLineTwo = customer.BillingAddress?.AddressLineTwo ?? string.Empty,
                    BillingTown = customer.BillingAddress?.Town ?? string.Empty,
                    BillingCounty = customer.BillingAddress?.County ?? string.Empty,
                    BillingPostCode = customer.BillingAddress?.PostCode ?? string.Empty,
                    BillingCountry = customer.BillingAddress?.Country ?? "UK"
                };
        }
        else
        {
            _errorMessage = "Unable to load your profile information.";
        }
    }

    private async Task HandleSubmit()
    {
        if (_updateCustomer == null)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        var success = await CustomerService.UpdateCustomer(_updateCustomer);

        if (success)
        {
            await RefreshAuthenticationState();

            _successMessage = "Saved.";
            StateHasChanged();
        }
        else
        {
            _errorMessage = "Something went wrong updating your profile.";
        }

        _isSubmitting = false;
    }

    private async Task RefreshAuthenticationState()
    {
        var result = await AuthService.RefreshAuthenticationState();

        if (!result)
        {
            _errorMessage = "Refresh auth state failed.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}