@page "/profile"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@inject IAuthService AuthService
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">
                                <i class="bi bi-person-circle me-2"></i>My Profile
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (!string.IsNullOrEmpty(SuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (isLoading)
                            {
                                <div class="text-center p-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2">Loading your profile...</p>
                                </div>
                            }
                            else if (updateModel != null)
                            {
                                <EditForm Model="updateModel" OnValidSubmit="HandleSubmit" Context="editContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger mb-3" />

                                    <h5 class="mb-3">Personal Information</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="firstName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>First Name
                                            </label>
                                            <InputText id="firstName" class="form-control" @bind-Value="updateModel.FirstName" />
                                            <ValidationMessage For="@(() => updateModel.FirstName)" class="text-danger" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="lastName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>Last Name
                                            </label>
                                            <InputText id="lastName" class="form-control" @bind-Value="updateModel.LastName" />
                                            <ValidationMessage For="@(() => updateModel.LastName)" class="text-danger" />
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="phoneNumber" class="form-label fw-semibold">
                                            <i class="bi bi-telephone me-1"></i>Phone Number
                                        </label>
                                        <InputText id="phoneNumber" class="form-control" @bind-Value="updateModel.PhoneNumber"
                                                   placeholder="Enter your phone number" />
                                        <ValidationMessage For="@(() => updateModel.PhoneNumber)" class="text-danger" />
                                    </div>

                                    <h5 class="mb-3">Shipping Address</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                                            <InputText id="shippingAddressLineOne" class="form-control" @bind-Value="updateModel.ShippingAddress.AddressLineOne" />
                                            <ValidationMessage For="@(() => updateModel.ShippingAddress.AddressLineOne)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                                            <InputText id="shippingAddressLineTwo" class="form-control" @bind-Value="updateModel.ShippingAddress.AddressLineTwo" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingTown" class="form-label fw-semibold">Town</label>
                                            <InputText id="shippingTown" class="form-control" @bind-Value="updateModel.ShippingAddress.Town" />
                                            <ValidationMessage For="@(() => updateModel.ShippingAddress.Town)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingCounty" class="form-label fw-semibold">County</label>
                                            <InputText id="shippingCounty" class="form-control" @bind-Value="updateModel.ShippingAddress.County" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingPostCode" class="form-label fw-semibold">Postcode</label>
                                            <InputText id="shippingPostCode" class="form-control" @bind-Value="updateModel.ShippingAddress.PostCode" />
                                            <ValidationMessage For="@(() => updateModel.ShippingAddress.PostCode)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingCountry" class="form-label fw-semibold">Country</label>
                                            <InputText id="shippingCountry" class="form-control" @bind-Value="updateModel.ShippingAddress.Country" />
                                            <ValidationMessage For="@(() => updateModel.ShippingAddress.Country)" class="text-danger" />
                                        </div>
                                    </div>

                                    <h5 class="mb-3">Billing Address</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                                            <InputText id="billingAddressLineOne" class="form-control" @bind-Value="updateModel.BillingAddress.AddressLineOne" />
                                            <ValidationMessage For="@(() => updateModel.BillingAddress.AddressLineOne)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                                            <InputText id="billingAddressLineTwo" class="form-control" @bind-Value="updateModel.BillingAddress.AddressLineTwo" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingTown" class="form-label fw-semibold">Town</label>
                                            <InputText id="billingTown" class="form-control" @bind-Value="updateModel.BillingAddress.Town" />
                                            <ValidationMessage For="@(() => updateModel.BillingAddress.Town)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingCounty" class="form-label fw-semibold">County</label>
                                            <InputText id="billingCounty" class="form-control" @bind-Value="updateModel.BillingAddress.County" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingPostCode" class="form-label fw-semibold">Postcode</label>
                                            <InputText id="billingPostCode" class="form-control" @bind-Value="updateModel.BillingAddress.PostCode" />
                                            <ValidationMessage For="@(() => updateModel.BillingAddress.PostCode)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingCountry" class="form-label fw-semibold">Country</label>
                                            <InputText id="billingCountry" class="form-control" @bind-Value="updateModel.BillingAddress.Country" />
                                            <ValidationMessage For="@(() => updateModel.BillingAddress.Country)" class="text-danger" />
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                                            @if (isSubmitting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle me-2"></i>
                                            }
                                            Update Profile
                                        </button>

                                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                                            <i class="bi bi-x-circle me-2"></i>Cancel
                                        </button>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <LoginRegisterAlert ReturnUrl="%2Fprofile" />
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private UpdateCustomerViewModel? updateModel;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            isLoading = true;
            var customer = await CustomerService.GetCustomerAsync();

            if (customer != null)
            {
                updateModel = new UpdateCustomerViewModel
                    {
                        Id = customer.Id,
                        FirstName = customer.FirstName,
                        LastName = customer.LastName,
                        PhoneNumber = customer.PhoneNumber,
                        ShippingAddress = new UpdateAddressViewModel
                        {
                            AddressLineOne = customer.ShippingAddress?.AddressLineOne,
                            AddressLineTwo = customer.ShippingAddress?.AddressLineTwo,
                            Town = customer.ShippingAddress?.Town,
                            County = customer.ShippingAddress?.County,
                            PostCode = customer.ShippingAddress?.PostCode,
                            Country = customer.ShippingAddress?.Country
                        },
                        BillingAddress = new UpdateAddressViewModel
                        {
                            AddressLineOne = customer.BillingAddress?.AddressLineOne,
                            AddressLineTwo = customer.BillingAddress?.AddressLineTwo,
                            Town = customer.BillingAddress?.Town,
                            County = customer.BillingAddress?.County,
                            PostCode = customer.BillingAddress?.PostCode,
                            Country = customer.BillingAddress?.Country
                        }
                    };
            }
            else
            {
                ErrorMessage = "Unable to load your profile information.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while loading your profile.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (updateModel == null) return;

        try
        {
            isSubmitting = true;
            ErrorMessage = null;
            SuccessMessage = null;

            // Use the existing CustomerService instead of AuthService
            var success = await CustomerService.UpdateCustomerAsync(updateModel);

            if (success)
            {
                // Refresh authentication state to update claims in header
                await RefreshAuthenticationState();

                SuccessMessage = "Your profile has been updated successfully! The changes will be reflected in the header.";

                // Small delay to show success message before clearing it
                await Task.Delay(3000);
                SuccessMessage = null;
                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Failed to update your profile. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RefreshAuthenticationState()
    {
        try
        {
            await AuthService.RefreshAuthenticationStateAsync();

            // Notify the authentication state provider of changes
            if (AuthService is AuthService authService)
            {
                await authService.RefreshAuthenticationStateAsync();
            }
        }
        catch (Exception ex)
        {
            // Log error but don't fail the update process
            Console.WriteLine($"Failed to refresh authentication state: {ex.Message}");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}