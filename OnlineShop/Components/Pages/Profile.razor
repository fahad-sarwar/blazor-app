@page "/profile"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject IAuthService AuthService
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">
                                <i class="bi bi-person-circle me-2"></i>My Profile
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (!string.IsNullOrEmpty(SuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (isLoading)
                            {
                                <div class="text-center p-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2">Loading your profile...</p>
                                </div>
                            }
                            else if (updateModel != null)
                            {
                                <EditForm Model="updateModel" OnValidSubmit="HandleSubmit" Context="editContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger mb-3" />

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="firstName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>First Name
                                            </label>
                                            <InputText id="firstName" class="form-control" @bind-Value="updateModel.FirstName" />
                                            <ValidationMessage For="@(() => updateModel.FirstName)" class="text-danger" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="lastName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>Last Name
                                            </label>
                                            <InputText id="lastName" class="form-control" @bind-Value="updateModel.LastName" />
                                            <ValidationMessage For="@(() => updateModel.LastName)" class="text-danger" />
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="phoneNumber" class="form-label fw-semibold">
                                            <i class="bi bi-telephone me-1"></i>Phone Number
                                        </label>
                                        <InputText id="phoneNumber" class="form-control" @bind-Value="updateModel.PhoneNumber"
                                        placeholder="Enter your phone number" />
                                        <ValidationMessage For="@(() => updateModel.PhoneNumber)" class="text-danger" />
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                                            @if (isSubmitting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle me-2"></i>
                                            }
                                            Update Profile
                                        </button>

                                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                                            <i class="bi bi-x-circle me-2"></i>Cancel
                                        </button>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="card">
                        <div class="card-body text-center p-5">
                            <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                            <h4 class="mb-3">Access Restricted</h4>
                            <p class="text-muted mb-4">You need to be logged in to view your profile.</p>
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="/account/login?returnUrl=%2Fprofile" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                                </a>
                                <a href="/account/register?returnUrl=%2Fprofile" class="btn btn-outline-secondary">
                                    <i class="bi bi-person-plus me-2"></i>Register
                                </a>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private UpdateCustomerViewModel? updateModel;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            isLoading = true;
            var userInfo = await AuthService.GetCurrentUserAsync();

            if (userInfo != null)
            {
                updateModel = new UpdateCustomerViewModel
                    {
                        Id = userInfo.CustomerId ?? 0,
                        FirstName = userInfo.FirstName ?? string.Empty,
                        LastName = userInfo.LastName ?? string.Empty,
                        PhoneNumber = userInfo.PhoneNumber ?? string.Empty
                    };
            }
            else
            {
                ErrorMessage = "Unable to load your profile information.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while loading your profile.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (updateModel == null) return;

        try
        {
            isSubmitting = true;
            ErrorMessage = null;
            SuccessMessage = null;

            // Use the existing CustomerService instead of AuthService
            var success = await CustomerService.UpdateCustomerAsync(updateModel);

            if (success)
            {
                // Refresh authentication state to update claims in header
                await RefreshAuthenticationState();

                SuccessMessage = "Your profile has been updated successfully! The changes will be reflected in the header.";

                // Small delay to show success message before clearing it
                await Task.Delay(3000);
                SuccessMessage = null;
                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Failed to update your profile. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RefreshAuthenticationState()
    {
        try
        {
            await AuthService.RefreshAuthenticationStateAsync();

            // Notify the authentication state provider of changes
            if (AuthService is AuthService authService)
            {
                await authService.RefreshAuthenticationStateAsync();
            }
        }
        catch (Exception ex)
        {
            // Log error but don't fail the update process
            Console.WriteLine($"Failed to refresh authentication state: {ex.Message}");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}