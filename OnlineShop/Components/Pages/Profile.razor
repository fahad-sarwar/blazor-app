@page "/profile"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@inject AuthService AuthService
@inject CustomerService CustomerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">
                                <i class="bi bi-person-circle me-2"></i>My Profile
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (!string.IsNullOrEmpty(_successMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>@_successMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@_errorMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (_isLoading)
                            {
                                <div class="text-center p-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2">Loading your profile...</p>
                                </div>
                            }
                            else if (_updateModel != null)
                            {
                                <EditForm Model="_updateModel" OnValidSubmit="HandleSubmit" Context="editContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger mb-3" />

                                    <h5 class="mb-3">Personal Information</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="firstName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>First Name
                                            </label>
                                            <InputText id="firstName" class="form-control" @bind-Value="_updateModel.FirstName" />
                                            <ValidationMessage For="@(() => _updateModel.FirstName)" class="text-danger" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="lastName" class="form-label fw-semibold">
                                                <i class="bi bi-person me-1"></i>Last Name
                                            </label>
                                            <InputText id="lastName" class="form-control" @bind-Value="_updateModel.LastName" />
                                            <ValidationMessage For="@(() => _updateModel.LastName)" class="text-danger" />
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="phoneNumber" class="form-label fw-semibold">
                                            <i class="bi bi-telephone me-1"></i>Phone Number
                                        </label>
                                        <InputText id="phoneNumber" class="form-control" @bind-Value="_updateModel.PhoneNumber"
                                                   placeholder="Enter your phone number" />
                                        <ValidationMessage For="@(() => _updateModel.PhoneNumber)" class="text-danger" />
                                    </div>

                                    <h5 class="mb-3">Shipping Address</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                                            <InputText id="shippingAddressLineOne" class="form-control" @bind-Value="_updateModel.ShippingAddressLineOne" />
                                            <ValidationMessage For="@(() => _updateModel.ShippingAddressLineOne)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                                            <InputText id="shippingAddressLineTwo" class="form-control" @bind-Value="_updateModel.ShippingAddressLineTwo" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingTown" class="form-label fw-semibold">Town</label>
                                            <InputText id="shippingTown" class="form-control" @bind-Value="_updateModel.ShippingTown" />
                                            <ValidationMessage For="@(() => _updateModel.ShippingTown)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingCounty" class="form-label fw-semibold">County</label>
                                            <InputText id="shippingCounty" class="form-control" @bind-Value="_updateModel.ShippingCounty" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingPostCode" class="form-label fw-semibold">Postcode</label>
                                            <InputText id="shippingPostCode" class="form-control" @bind-Value="_updateModel.ShippingPostCode" />
                                            <ValidationMessage For="@(() => _updateModel.ShippingPostCode)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="shippingCountry" class="form-label fw-semibold">Country</label>
                                            <InputText id="shippingCountry" class="form-control" @bind-Value="_updateModel.ShippingCountry" />
                                            <ValidationMessage For="@(() => _updateModel.ShippingCountry)" class="text-danger" />
                                        </div>
                                    </div>

                                    <h5 class="mb-3">Billing Address</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingAddressLineOne" class="form-label fw-semibold">Address Line 1</label>
                                            <InputText id="billingAddressLineOne" class="form-control" @bind-Value="_updateModel.BillingAddressLineOne" />
                                            <ValidationMessage For="@(() => _updateModel.BillingAddressLineOne)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingAddressLineTwo" class="form-label fw-semibold">Address Line 2</label>
                                            <InputText id="billingAddressLineTwo" class="form-control" @bind-Value="_updateModel.BillingAddressLineTwo" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingTown" class="form-label fw-semibold">Town</label>
                                            <InputText id="billingTown" class="form-control" @bind-Value="_updateModel.BillingTown" />
                                            <ValidationMessage For="@(() => _updateModel.BillingTown)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingCounty" class="form-label fw-semibold">County</label>
                                            <InputText id="billingCounty" class="form-control" @bind-Value="_updateModel.BillingCounty" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="billingPostCode" class="form-label fw-semibold">Postcode</label>
                                            <InputText id="billingPostCode" class="form-control" @bind-Value="_updateModel.BillingPostCode" />
                                            <ValidationMessage For="@(() => _updateModel.BillingPostCode)" class="text-danger" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="billingCountry" class="form-label fw-semibold">Country</label>
                                            <InputText id="billingCountry" class="form-control" @bind-Value="_updateModel.BillingCountry" />
                                            <ValidationMessage For="@(() => _updateModel.BillingCountry)" class="text-danger" />
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-success" disabled="@_isSubmitting">
                                            @if (_isSubmitting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-circle me-2"></i>
                                            }
                                            Update Profile
                                        </button>

                                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                                            <i class="bi bi-x-circle me-2"></i>Cancel
                                        </button>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <LoginRegisterAlert ReturnUrl="%2Fprofile" />
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private UpdateCustomerViewModel? _updateModel;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        _isLoading = true;
        var customer = await CustomerService.GetCustomer();

        if (customer != null)
        {
            _updateModel = new UpdateCustomerViewModel
                {
                    Id = customer.Id,
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    PhoneNumber = customer.PhoneNumber,
                    ShippingAddressLineOne = customer.ShippingAddress?.AddressLineOne ?? string.Empty,
                    ShippingAddressLineTwo = customer.ShippingAddress?.AddressLineTwo ?? string.Empty,
                    ShippingTown = customer.ShippingAddress?.Town ?? string.Empty,
                    ShippingCounty = customer.ShippingAddress?.County ?? string.Empty,
                    ShippingPostCode = customer.ShippingAddress?.PostCode ?? string.Empty,
                    ShippingCountry = customer.ShippingAddress?.Country ?? "UK",
                    BillingAddressLineOne = customer.BillingAddress?.AddressLineOne ?? string.Empty,
                    BillingAddressLineTwo = customer.BillingAddress?.AddressLineTwo ?? string.Empty,
                    BillingTown = customer.BillingAddress?.Town ?? string.Empty,
                    BillingCounty = customer.BillingAddress?.County ?? string.Empty,
                    BillingPostCode = customer.BillingAddress?.PostCode ?? string.Empty,
                    BillingCountry = customer.BillingAddress?.Country ?? "UK"
                };
        }
        else
        {
            _errorMessage = "Unable to load your profile information.";
        }

        _isLoading = false;
    }

    private async Task HandleSubmit()
    {
        if (_updateModel == null)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        var success = await CustomerService.UpdateCustomer(_updateModel);

        if (success)
        {
            await RefreshAuthenticationState();

            _successMessage = "Your profile has been updated successfully! The changes will be reflected in the header.";
            _successMessage = null;
            StateHasChanged();
        }
        else
        {
            _errorMessage = "Failed to update your profile. Please try again.";
        }

        _isSubmitting = false;
    }

    private async Task RefreshAuthenticationState()
    {
        var result = await AuthService.RefreshAuthenticationStateAsync();

        if (!result)
        {
            _errorMessage = "Failed to refresh authentication state. Please log out and log back in to see the changes.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}