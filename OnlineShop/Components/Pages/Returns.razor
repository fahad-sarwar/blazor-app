@page "/returns/{OrderId:int}"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject ReturnService ReturnService
@inject OrderService OrderService
@rendermode InteractiveServer

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="bi bi-arrow-return-left me-3"></i>Return Request
                </h1>
                <div>
                    <a href="/orders" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Orders
                    </a>
                    <a href="/returns" class="btn btn-outline-info">
                        <i class="bi bi-info-circle me-1"></i>Returns Policy
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Brief Policy Summary -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Return Window:</strong> 30 days from delivery. Items must be unused and in original packaging.
                <a href="/returns" class="alert-link">View full policy</a>
            </div>
        </div>
    </div>

    <!-- Return Form Section -->
    <AuthorizeView Context="authContext">
        <Authorized>
            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading order details...</p>
                </div>
            }
            else if (order == null)
            {
                <div class="alert alert-warning">
                    <h4>Order Not Found</h4>
                    <p>The order you're trying to return could not be found or you don't have permission to access it.</p>
                    <a href="/orders" class="btn btn-primary">View My Orders</a>
                </div>
            }
            else
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-file-earmark-text me-2"></i>Return Items from Order @order.OrderNumber
                        </h4>
                        <small>Order placed on @order.CreatedAt.ToString("dd MMM yyyy")</small>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                                <div class="mt-2">
                                    <a href="/orders" class="btn btn-outline-success">Back to Orders</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <div class="alert alert-danger">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                                </div>
                            }

                            <EditForm Model="formModel" OnValidSubmit="SubmitReturnRequest" Context="editContext">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger mb-3" />

                                <h5>Select items to return:</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="50">Return</th>
                                                <th>Product</th>
                                                <th width="80">Qty</th>
                                                <th width="200">Reason</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in selectedItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <InputCheckbox @bind-Value="item.IsSelected" class="form-check-input" />
                                                    </td>
                                                    <td>
                                                        <strong>@item.ProductName</strong>
                                                    </td>
                                                    <td>
                                                        @{
                                                            var orderItem = order.OrderItems.FirstOrDefault(oi => oi.Id == item.OrderItemId);
                                                            if (orderItem != null)
                                                            {
                                                                @orderItem.Quantity
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        <InputSelect class="form-select form-select-sm" @bind-Value="item.Reason"
                                                                     disabled="@(!item.IsSelected)">
                                                            <option value="">Select reason</option>
                                                            <option value="Wrong Size">Wrong Size</option>
                                                            <option value="Wrong Color">Wrong Color</option>
                                                            <option value="Defective/Damaged">Defective/Damaged</option>
                                                            <option value="Not as Described">Not as Described</option>
                                                            <option value="Changed Mind">Changed Mind</option>
                                                            <option value="Ordered by Mistake">Ordered by Mistake</option>
                                                            <option value="Other">Other</option>
                                                        </InputSelect>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        <i class="bi bi-chat-text me-1"></i>Additional Comments (Optional)
                                    </label>
                                    <InputTextArea class="form-control" @bind-Value="formModel.Comments" rows="3"
                                                   placeholder="Please provide any additional details about your return..." />
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-send me-2"></i>
                                        }
                                        Submit Return Request
                                    </button>
                                    <a href="/orders" class="btn btn-outline-secondary">Cancel</a>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="card">
                <div class="card-body text-center p-5">
                    <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                    <h4 class="mb-3">Login Required</h4>
                    <p class="text-muted mb-4">You need to be logged in to start a return request.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/account/login?returnUrl=%2Freturns/@OrderId" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </a>
                        <a href="/account/register?returnUrl=%2Freturns/@OrderId" class="btn btn-outline-secondary">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </a>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public int OrderId { get; set; }
    private OrderViewModel? order;
    private List<ReturnOrderItemViewModel> selectedItems = new();
    private ReturnFormModel formModel = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        order = await OrderService.GetOrderByIdAsync(OrderId);
        if (order != null)
        {
            selectedItems = order.OrderItems.Select(item => new ReturnOrderItemViewModel
                {
                    OrderItemId = item.Id,
                    ProductName = item.Product.Name,
                    IsSelected = false,
                    Reason = ""
                }).ToList();
        }
        isLoading = false;
    }

    private async Task SubmitReturnRequest()
    {
        isSubmitting = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var itemsToReturn = selectedItems.Where(i => i.IsSelected).ToList();
        if (!itemsToReturn.Any())
        {
            ErrorMessage = "Please select at least one item to return.";
            isSubmitting = false;
            return;
        }

        var request = new CreateReturnViewModel
            {
                OrderId = OrderId,
                Items = itemsToReturn.Select(i => new CreateReturnItemViewModel
                {
                    OrderItemId = i.OrderItemId,
                    Reason = i.Reason
                }).ToList(),
                Comments = formModel.Comments ?? ""
            };

        var success = await ReturnService.CreateReturnAsync(request);
        if (success)
        {
            SuccessMessage = "Your return request has been submitted successfully!";
            formModel = new ReturnFormModel(); // Reset form
            selectedItems.ForEach(i => { i.IsSelected = false; i.Reason = ""; });
        }
        else
        {
            ErrorMessage = "Failed to submit your return request. Please try again.";
        }
        isSubmitting = false;
    }

    public class ReturnFormModel
    {
        public string Comments { get; set; } = "";
    }

    public class ReturnOrderItemViewModel
    {
        public int OrderItemId { get; set; }
        public string ProductName { get; set; } = "";
        public bool IsSelected { get; set; }
        public string Reason { get; set; } = "";
    }
}