@page "/orders"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@inject OrderService OrderService
@rendermode InteractiveServer

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="row row-cols-1 g-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3>My Orders</h3>
                    <a href="/" class="btn btn-primary">
                        Continue Shopping
                    </a>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_errorMessage
                    </div>
                }

                @if (_isLoading)
                {
                    <p>Loading order...</p>
                }
                else if (_orders.Count == 0)
                {
                    <p>You haven't placed any orders yet. Start shopping to see your orders here!</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Order Number</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th>Estimated Delivery</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in _orders)
                                {
                                    <tr>
                                        <td>@order.OrderNumber</td>
                                        <td>@order.GetFormattedCreatedAtDate()</td>
                                        <td>@order.Status</td>
                                        <td>@order.FormattedTotalPrice()</td>
                                        <td>@order.GetFormattedEstimatedDeliveryDate()</td>
                                        <td class="text-end">
                                            <a class="btn btn-primary" href="/order-details/@order.Id">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (HasMore())
                    {
                        <div class="text-center mt-4">
                            <button class="btn btn-outline-primary" @onclick="LoadMore" disabled="@_isLoadingMore">Load More</button>
                        </div>
                    }
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <LoginRegisterAlert ReturnUrl="%2Forders" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly List<OrderViewModel> _orders = new();
    private bool _isLoading = true;
    private bool _isLoadingMore;
    private int _currentPage = 1;
    private readonly int _pageSize = 10;
    private int _totalCount = 0;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders(reset: true);
    }

    private async Task LoadOrders(bool reset = false)
    {
        if (reset)
        {
            _isLoading = true;
            _orders.Clear();
            _currentPage = 1;
        }
        else
        {
            _isLoadingMore = true;
        }

        _errorMessage = null;

        var result = await OrderService.GetOrders(_currentPage, _pageSize);

        if (result != null)
        {
            _orders.AddRange(result.Orders);
            _totalCount = result.TotalCount;
        }
        else
        {
            _errorMessage = "Failed to load orders. Please try again.";
        }

        _isLoading = false;
        _isLoadingMore = false;
    }

    private bool HasMore()
    {
        return _orders.Count < _totalCount;
    }

    private async Task LoadMore()
    {
        _currentPage++;
        await LoadOrders();
    }
}