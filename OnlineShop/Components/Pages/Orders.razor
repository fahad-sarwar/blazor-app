@page "/orders"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject OrderService OrderService
@rendermode InteractiveServer

<div class="container mt-4">
    <AuthorizeView Context="authContext">
        <Authorized>
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2>
                            <i class="bi bi-box-seam me-2"></i>My Orders
                        </h2>
                        <a href="/" class="btn btn-outline-primary">
                            <i class="bi bi-house me-2"></i>Continue Shopping
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                        </div>
                    }

                    @if (isLoading && !orders.Any())
                    {
                        <div class="text-center p-5">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Loading your orders...</p>
                        </div>
                    }
                    else if (!orders.Any())
                    {
                        <div class="card">
                            <div class="card-body text-center p-5">
                                <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                                <h4 class="mb-3">No Orders Found</h4>
                                <p class="text-muted mb-4">You haven't placed any orders yet. Start shopping to see your orders here!</p>
                                <a href="/" class="btn btn-primary">
                                    <i class="bi bi-cart me-2"></i>Start Shopping
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card shadow-sm">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Order Number</th>
                                                <th>Date</th>
                                                <th>Status</th>
                                                <th class="text-end">Total</th>
                                                <th>Estimated Delivery</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in orders)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="fw-bold text-primary">@order.OrderNumber</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-muted">@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                                        <br>
                                                        <small class="text-muted">@order.CreatedAt.ToLocalTime().ToString("HH:mm")</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge @GetStatusBadgeClass(order.Status)">
                                                            @order.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">£@order.TotalPrice.ToString("0.00")</span>
                                                    </td>
                                                    <td>
                                                        @if (order.EstimatedDelivery.HasValue)
                                                        {
                                                            <span class="text-muted">@order.EstimatedDelivery.Value.ToString("dd MMM yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">TBD</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="/order-details/@order.Id" class="btn btn-sm btn-outline-primary me-2">
                                                            <i class="bi bi-eye me-1"></i>View Details
                                                        </a>
                                                        <a href="/returns/@order.Id" class="btn btn-sm btn-outline-warning">
                                                            <i class="bi bi-arrow-return-left me-1"></i>Request Return
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (hasMore)
                            {
                                <div class="card-footer text-center">
                                    <button class="btn btn-outline-primary" @onclick="LoadMore" disabled="@isLoadingMore">
                                        @if (isLoadingMore)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-down me-2"></i>
                                        }
                                        Load More Orders
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <i class="bi bi-headset display-4 text-primary mb-3"></i>
                                        <h5>Need Help?</h5>
                                        <p class="text-muted">Contact our support team for any order-related questions.</p>
                                        <a href="/contact" class="btn btn-outline-primary btn-sm">Contact Support</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <i class="bi bi-truck display-4 text-success mb-3"></i>
                                        <h5>Track Your Order</h5>
                                        <p class="text-muted">Get real-time updates on your order status and delivery.</p>
                                        <a href="/track-order" class="btn btn-outline-success btn-sm">Track Orders</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <i class="bi bi-arrow-return-left display-4 text-warning mb-3"></i>
                                        <h5>Returns & Refunds</h5>
                                        <p class="text-muted">Learn about our return policy and process refunds.</p>
                                        <a href="/returns" class="btn btn-outline-warning btn-sm">Return Policy</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="card">
                <div class="card-body text-center p-5">
                    <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                    <h4 class="mb-3">Access Restricted</h4>
                    <p class="text-muted mb-4">You need to be logged in to view your orders.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/account/login?returnUrl=%2Forders" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </a>
                        <a href="/account/register?returnUrl=%2Forders" class="btn btn-outline-secondary">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </a>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private List<OrderViewModel> orders = new();
    private bool isLoading = true;
    private bool isLoadingMore = false;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private bool hasMore => orders.Count < totalCount;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders(reset: true);
    }

    private async Task LoadOrders(bool reset = false)
    {
        try
        {
            if (reset)
            {
                isLoading = true;
                orders.Clear();
                currentPage = 1;
            }
            else
            {
                isLoadingMore = true;
            }

            ErrorMessage = null;

            var result = await OrderService.GetOrdersAsync(currentPage, pageSize);
            if (result != null)
            {
                orders.AddRange(result.Orders);
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load orders. Please try again.";
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
        }
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadOrders();
    }

    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "processing" => "bg-info text-white",
            "packed" => "bg-primary text-white",
            "shipped" => "bg-success text-white",
            "out for delivery" => "bg-success text-white",
            "delivered" => "bg-success text-white",
            "cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}