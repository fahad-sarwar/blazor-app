@page "/orders"

@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@using OnlineShopUI.Components.Shared
@inject OrderService OrderService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

@if (CustomAuthenticationStateProvider.IsUserAuthenticated())
{
    <div class="row row-cols-1 g-4">
        <div class="col-12">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">
                    @_errorMessage
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3>My Orders</h3>
                <a href="/" class="btn btn-primary">
                    Continue Shopping
                </a>
            </div>

            @if (_orders.Count == 0)
            {
                <p>You haven't placed any orders yet. Start shopping to see your orders here!</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order Number</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Estimated Delivery</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.GetFormattedCreatedAtDate()</td>
                                    <td>@order.Status</td>
                                    <td>@order.FormattedTotalPrice()</td>
                                    <td>@order.GetFormattedEstimatedDeliveryDate()</td>
                                    <td class="text-end">
                                        <a class="btn btn-primary" href="/order-details/@order.Id">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <LoginRegisterAlert ReturnUrl="%2Forders" />
}

@code {
    private List<OrderViewModel> _orders = new List<OrderViewModel>();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders(reset: true);
    }

    private async Task LoadOrders(bool reset = false)
    {
        if (reset)
        {
            _orders.Clear();
        }

        _errorMessage = null;

        _orders = await OrderService.GetOrders();
    }
}