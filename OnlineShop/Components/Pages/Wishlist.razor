@page "/wishlist"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Shared
@inject WishlistService WishlistService
@rendermode InteractiveServer

<h3>My Wishlist</h3>

<AuthorizeView Context="authContext">
    <Authorized>
        @if (_isLoading)
        {
            <p>Loading wishlist...</p>
        }
        else if (_products.Count == 0)
        {
            <p>Your wishlist is empty.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in _products)
                {
                    <ProductSummaryItem Product="product" ShowRemoveButton="true" OnProductRemovedFromWishlist="HandleItemRemoved" />
                }
            </div>

            @if (HasMore())
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary" @onclick="LoadMore">Load More</button>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <LoginRegisterAlert ReturnUrl="%2F" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ProductViewModel> _products = new();
    private bool _isLoading = false;
    private int _currentPage = 1;
    private readonly int _pageSize = 9;
    private int _totalProducts = 0;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        await LoadWishlist();

        _isLoading = false;
    }

    private async Task LoadWishlist()
    {
        var pagedProductResult = await WishlistService.GetWishlist(_currentPage, _pageSize);

        if (pagedProductResult != null)
        {
            _products.AddRange(pagedProductResult.Products);
            _totalProducts = pagedProductResult.TotalCount;
        }
        else
        {
            _products = new List<ProductViewModel>();
            _totalProducts = 0;
        }
    }

    private bool HasMore()
    {
        return _currentPage * _pageSize < _totalProducts;
    }

    private async Task LoadMore()
    {
        _currentPage += 1;
        await LoadWishlist();
    }

    private async Task HandleItemRemoved(int productId)
    {
        _products.RemoveAll(p => p.Id == productId);
    }
}
