@page "/wishlist"

@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@using OnlineShopUI.Components.Shared
@inject WishlistService WishlistService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

<h3>My Wishlist</h3>

@if (CustomAuthenticationStateProvider.IsUserAuthenticated())
{
    if (_products.Count == 0)
    {
        <p>Your wishlist is empty.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in _products)
            {
                <ProductSummaryItem Product="product" ShowRemoveButton="true" OnProductRemovedFromWishlist="HandleItemRemoved" />
            }
        </div>
    }
}
else
{
    <LoginRegisterAlert ReturnUrl="%2F" />
}

@code {
    private List<ProductViewModel> _products = new();

    protected override async Task OnInitializedAsync()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged += OnAuthStateChanged;

        await LoadWishlist();
    }

    public void Dispose()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged -= OnAuthStateChanged;
    }

    private async Task OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadWishlist()
    {
        var result = await WishlistService.GetWishlist();

        if (result != null)
        {
            _products.AddRange(result);
        }
        else
        {
            _products = new List<ProductViewModel>();
        }
    }

    private async Task HandleItemRemoved(int productId)
    {
        _products.RemoveAll(p => p.Id == productId);
    }
}
