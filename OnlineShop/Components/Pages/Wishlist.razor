@page "/wishlist"

@using OnlineShopUI.Components.Layout
@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject BasketService BasketService
@inject WishlistService WishlistService
@rendermode InteractiveServer

<h3>My Wishlist</h3>

<AuthorizeView Context="authContext">
    <Authorized>
        @if (products == null)
        {
            <p>Loading...</p>
        }
        else if (!products.Any())
        {
            <p>Your wishlist is empty.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in products)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="@product.ImageURL"
                                 class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" />

                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">£@product.Price.ToString("0.00")</p>
                                <a class="btn btn-primary" href="/product/@product.Id">View</a>
                                <button class="btn btn-secondary" @onclick="async () => await AddToBasket(product.Id)">Add to Basket</button>
                                <button class="btn btn-danger" @onclick="async () => await RemoveFromWishlist(product.Id)">Remove</button>
                                @if (!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="text-danger mt-2">@ErrorMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (hasMore)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary" @onclick="LoadMore">Load More</button>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <p>You need to be logged in to access checkout.</p>
            <a href="/account/login?returnUrl=%2Fcheckout" class="btn btn-primary">Login</a>
            <a href="/account/register?returnUrl=%2Fcheckout" class="btn btn-secondary">Register</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ProductViewModel> products = new();
    [CascadingParameter] public MainLayout? MainLayout { get; set; }
    private string? ErrorMessage;
    private int currentPage = 1;
    private int pageSize = 9;
    private int totalProducts = 0;
    private string selectedSort = "name-asc";
    private bool hasMore => (currentPage * pageSize) < totalProducts;

    protected override async Task OnInitializedAsync()
    {
        await LoadWishlist();
    }

    private async Task LoadWishlist()
    {
        try
        {
            var pagedProductResult = await WishlistService.GetWishlistAsync(currentPage, pageSize);
            products.AddRange(pagedProductResult.Products);
            totalProducts = pagedProductResult.TotalCount;
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error fetching wishlist: {ex.Message}");
            products = new List<ProductViewModel>();
            totalProducts = 0;
        }
    }

    private async Task LoadMore()
    {
        currentPage += 1;
        await LoadWishlist();
    }

    private async Task RemoveFromWishlist(int productId)
    {
        var success = await WishlistService.RemoveFromWishlistAsync(productId);

        if (success)
        {
            products.RemoveAll(p => p.Id == productId);
            ErrorMessage = null;
        }
        else
        {
            ErrorMessage = "Failed to remove product from the wishlist. Please try again.";
        }
    }

    private async Task AddToBasket(int productId)
    {
        var result = await BasketService.AddToBasketAsync(productId, 1);

        if (result)
        {
            ErrorMessage = null;
        }
        else
        {
            ErrorMessage = "Failed to add item to basket. Please try again.";
        }
    }
}
