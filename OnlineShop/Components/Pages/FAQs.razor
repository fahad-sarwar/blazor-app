@page "/faqs"
@using OnlineShopUI.ViewModels

<h3 class="mb-4">Frequently Asked Questions (FAQs)</h3>

<div class="accordion" id="accordionFaq">
    @foreach(var faq in _faqs)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="@faq.Id">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@faq.Question.Id" aria-expanded="false" aria-controls="@faq.Question.Id">
                    @faq.Title
                </button>
            </h2>
            <div id="@faq.Question.Id" class="accordion-collapse collapse" aria-labelledby="@faq.Id" data-bs-parent="#accordionFaq">
                <div class="accordion-body">
                    @((MarkupString)faq.Question.Text)
                </div>
            </div>
        </div>
    }
</div>
@code {
    private readonly List<FaqSectionViewModel> _faqs = new List<FaqSectionViewModel>()
    {
        new FaqSectionViewModel
        {
            Id = "faq1", 
            Title = "When will my order arrive?", 
