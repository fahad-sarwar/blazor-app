@page "/faqs"

<h3 class="mb-4">Frequently Asked Questions (FAQs)</h3>

<div class="accordion" id="accordionFaq">
    <div class="accordion-item">
        <h2 class="accordion-header" id="faq1">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question1" aria-expanded="false" aria-controls="question1">
                When will my order arrive?
            </button>
        </h2>
        <div id="question1" class="accordion-collapse collapse" aria-labelledby="faq1" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                Standard delivery takes 3–5 working days. Next-day delivery is available if you order before 2pm.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq2">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question2" aria-expanded="false" aria-controls="question2">
                Can I track my order?
            </button>
        </h2>
        <div id="question2" class="accordion-collapse collapse" aria-labelledby="faq2" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                Yes! You'll receive a tracking link by email once your order has been dispatched.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq3">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question3" aria-expanded="false" aria-controls="question3">
                What payment methods do you accept?
            </button>
        </h2>
        <div id="question3" class="accordion-collapse collapse" aria-labelledby="faq3" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                We accept Visa, Mastercard, PayPal, Apple Pay, Klarna, and Clearpay.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq4">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question4" aria-expanded="false" aria-controls="question4">
                How do I return an item?
            </button>
        </h2>
        <div id="question4" class="accordion-collapse collapse" aria-labelledby="faq4" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                Returns are free and easy. Just use our return portal to print a prepaid label and send the item back within 30 days.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq5">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question5" aria-expanded="false" aria-controls="question5">
                Can I change or cancel my order after placing it?
            </button>
        </h2>
        <div id="question5" class="accordion-collapse collapse" aria-labelledby="faq5" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                You can change or cancel your order within 1 hour of placing it. After that, it may already be processing for shipment.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq6">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question6" aria-expanded="false" aria-controls="question6">
                What if my item arrives damaged or incorrect?
            </button>
        </h2>
        <div id="question6" class="accordion-collapse collapse" aria-labelledby="faq6" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                We're sorry! Please <a href="/contact" class="link-primary">contact us</a> within 48 hours of delivery, and we'll make it right with a refund or replacement.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq7">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question7" aria-expanded="false" aria-controls="question7">
                Do you ship internationally?
            </button>
        </h2>
        <div id="question7" class="accordion-collapse collapse" aria-labelledby="faq7" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                Yes, we ship to most countries in Europe and North America. Shipping fees and delivery times will vary by location.
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header" id="faq8">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question8" aria-expanded="false" aria-controls="question8">
                Need more help?
            </button>
        </h2>
        <div id="question8" class="accordion-collapse collapse" aria-labelledby="faq8" data-bs-parent="#accordionFaq">
            <div class="accordion-body">
                No problem! <a href="/contact" class="link-primary text-decoration-underline">Contact our team</a> and we'll get back to you ASAP.
            </div>
        </div>
    </div>
</div>
