@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject ReviewService ReviewService
@rendermode InteractiveServer

<div class="review-form-section mt-5">
    @if (!_showForm)
    {
        <div class="text-center">
            <button class="btn btn-primary btn-lg" @onclick="ShowForm">
                Write a Review
            </button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Add Your Review</h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="NewReview" OnValidSubmit="HandleSubmit" Context="editContext">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="subject" class="form-label fw-semibold">Subject</label>
                        <InputText id="subject" class="form-control" @bind-Value="NewReview.Subject" placeholder="Brief summary of your review" />
                        <ValidationMessage For="@(() => NewReview.Subject)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating</label>

                        <div class="rating-input d-flex align-items-center">
                            @for (var i = 1; i <= 5; i++)
                            {
                                var currentStar = i;

                                <button type="button" class="btn btn-link p-1 me-1" style="font-size: 2rem; line-height: 1;" @onclick="() => SetRating(currentStar)">
                                    <i class="bi @(currentStar <= NewReview.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary")"></i>
                                </button>
                            }
                            <span class="ms-2 text-muted">(@NewReview.Rating out of 5)</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="comment" class="form-label fw-semibold">Comment</label>
                        <InputTextArea id="comment" class="form-control" @bind-Value="NewReview.Comment" rows="4" placeholder="Share your experience with this product..." />
                        <ValidationMessage For="@(() => NewReview.Comment)" class="text-danger" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success" disabled="@_disableSubmitButton">Submit Review</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int ProductId { get; set; }

    private CreateReviewViewModel NewReview { get; set; } = new() { Rating = 5 };
    private bool _showForm;
    private bool _disableSubmitButton;
    private string? _successMessage;
    private string? _errorMessage;

    private void ShowForm()
    {
        _showForm = true;
        _disableSubmitButton = false;
        NewReview = new CreateReviewViewModel { Rating = 5 };
        _successMessage = null;
        _errorMessage = null;
    }

    private void CancelForm()
    {
        _showForm = false;
        _disableSubmitButton = false;
        NewReview = new CreateReviewViewModel { Rating = 5 };
        _successMessage = null;
        _errorMessage = null;
    }

    private void SetRating(int rating)
    {
        NewReview.Rating = rating;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        NewReview.ProductId = ProductId;

        var success = await ReviewService.CreateReview(NewReview);

        if (success)
        {
            _errorMessage = null;
            _disableSubmitButton = true;
            _successMessage = "Your review has been submitted and is pending approval.";
        }
        else
        {
            _disableSubmitButton = false;
            _errorMessage = "Failed to submit review. Please try again.";
            _successMessage = null;
        }
    }
}
