@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject ReviewService ReviewService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

@if (Reviews.Count > 0)
{
    <div class="reviews-section">
        <h4 class="mb-4">Customer Reviews</h4>
        @foreach (var review in Reviews)
        {
            <div class="card mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong class="text-primary">@review.CustomerName</strong>
                            <div class="rating-stars mt-1">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                }
                                <span class="ms-2 text-muted">(@review.Rating/5)</span>
                            </div>
                        </div>
                        <span class="text-muted small">@review.GetFormattedDate()</span>
                    </div>
                    <h6 class="fw-semibold mb-2">@review.Subject</h6>
                    <p class="mb-0 text-secondary">@review.Comment</p>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center p-4">
        <p class="text-muted">No reviews yet. Be the first to write a review!</p>
    </div>
}

@if (CustomAuthenticationStateProvider.IsUserAuthenticated())
{
    <CreateProductReview ProductId="@ProductId" />
}

@code {
    [Parameter] public int ProductId { get; set; }

    private List<ReviewViewModel> Reviews { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews(reset: true);
    }

    private async Task LoadReviews(bool reset = false)
    {

        if (reset)
        {
            Reviews.Clear();
        }

        Reviews = await ReviewService.GetPagedReviews(ProductId);
    }
}
