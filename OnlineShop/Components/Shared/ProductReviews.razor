@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject ReviewService ReviewService

<div class="reviews-container">
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (isLoading)
    {
        <div class="text-center p-4">
            <p>Loading reviews...</p>
        </div>
    }
    else if (Reviews.Any())
    {
        <div class="reviews-section">
            <h4 class="mb-4">Customer Reviews</h4>
            @foreach (var review in Reviews)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="text-primary">@review.CustomerName</strong>
                                <div class="rating-stars mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                    }
                                    <span class="ms-2 text-muted">(@review.Rating/5)</span>
                                </div>
                            </div>
                            <span class="text-muted small">@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                        </div>
                        <h6 class="fw-semibold mb-2">@review.Subject</h6>
                        <p class="mb-0 text-secondary">@review.Comment</p>
                    </div>
                </div>
            }
            @if (hasMore)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary" @onclick="LoadMore">Load More Reviews</button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-4">
            <p class="text-muted">No reviews yet. Be the first to leave one!</p>
        </div>
    }

    <AuthorizeView Context="authContext">
        <Authorized>
            <div class="review-form-section mt-5">
                @if (!showForm)
                {
                    <div class="text-center">
                        <button class="btn btn-primary btn-lg" @onclick="() => showForm = true">
                            <i class="bi bi-pencil-square me-2"></i>Write a Review
                        </button>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Add Your Review</h5>
                        </div>
                        <div class="card-body p-4">
                            <EditForm Model="NewReview" OnValidSubmit="HandleSubmit" Context="editContext">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger mb-3" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Subject</label>
                                    <InputText class="form-control" @bind-Value="NewReview.Subject"
                                               placeholder="Brief summary of your review" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Rating</label>
                                    <div class="rating-input d-flex align-items-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            int currentStar = i;
                                            <button type="button"
                                                    class="btn btn-link p-1 me-1"
                                                    style="font-size: 2rem; line-height: 1;"
                                                    @onclick="() => SetRating(currentStar)">
                                                <i class="bi @(currentStar <= NewReview.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary")"></i>
                                            </button>
                                        }
                                        <span class="ms-2 text-muted">(@NewReview.Rating out of 5)</span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Comment</label>
                                    <InputTextArea class="form-control" @bind-Value="NewReview.Comment"
                                                   rows="4" placeholder="Share your experience with this product..." />
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check-circle me-2"></i>Submit Review
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">
                                        <i class="bi bi-x-circle me-2"></i>Cancel
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public int ProductId { get; set; }

    private List<ReviewViewModel> Reviews { get; set; } = new();
    private CreateReviewViewModel NewReview { get; set; } = new() { Rating = 5 };
    private bool showForm = false;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalCount = 0;
    private bool hasMore => Reviews.Count < totalCount;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews(reset: true);
    }

    private async Task LoadReviews(bool reset = false)
    {
        try
        {
            isLoading = true;
            ErrorMessage = null;
            if (reset)
            {
                Reviews.Clear();
                currentPage = 1;
            }
            var result = await ReviewService.GetPagedReviewsAsync(ProductId, currentPage, pageSize);
            if (result != null)
            {
                Reviews.AddRange(result.Reviews);
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading reviews: {ex.Message}";
            Reviews = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadReviews();
    }

    private void SetRating(int rating)
    {
        NewReview.Rating = rating;
        StateHasChanged();
    }

    private void CancelForm()
    {
        showForm = false;
        NewReview = new CreateReviewViewModel { Rating = 5 };
        SuccessMessage = null;
        ErrorMessage = null;
    }

    private async Task HandleSubmit()
    {
        try
        {
            ErrorMessage = null;
            NewReview.ProductId = ProductId;
            var success = await ReviewService.CreateReviewAsync(NewReview);
            if (success)
            {
                showForm = false;
                NewReview = new CreateReviewViewModel { Rating = 5 };
                SuccessMessage = "Your review has been submitted and is pending approval.";
                await LoadReviews(reset: true);
            }
            else
            {
                ErrorMessage = "Failed to submit review. Please try again.";
                SuccessMessage = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to submit review: {ex.Message}";
            SuccessMessage = null;
        }
    }
}
