@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject ReviewService ReviewService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider
@rendermode InteractiveServer

@if (_isLoading)
{
    <div class="text-center p-4">
        <p>Loading reviews...</p>
    </div>
}
else if (Reviews.Count > 0)
{
    <div class="reviews-section">
        <h4 class="mb-4">Customer Reviews</h4>
        @foreach (var review in Reviews)
        {
            <div class="card mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong class="text-primary">@review.CustomerName</strong>
                            <div class="rating-stars mt-1">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                }
                                <span class="ms-2 text-muted">(@review.Rating/5)</span>
                            </div>
                        </div>
                        <span class="text-muted small">@review.GetFormattedDate()</span>
                    </div>
                    <h6 class="fw-semibold mb-2">@review.Subject</h6>
                    <p class="mb-0 text-secondary">@review.Comment</p>
                </div>
            </div>
        }

        @if (HasMore())
        {
            <div class="text-center mt-4">
                <button class="btn btn-outline-primary" @onclick="LoadMore">Load More Reviews</button>
            </div>
        }
    </div>
}
else
{
    <div class="text-center p-4">
        <p class="text-muted">No reviews yet. Be the first to write a review!</p>
    </div>
}

@if (CustomAuthenticationStateProvider.IsUserAuthenticated())
{
    <CreateProductReview ProductId="@ProductId" />
}

@code {
    [Parameter] public int ProductId { get; set; }

    private List<ReviewViewModel> Reviews { get; set; } = new();
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 5;
    private int _totalCount = 0;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews(reset: true);
    }

    private async Task LoadReviews(bool reset = false)
    {
        _isLoading = true;
        _errorMessage = null;

        if (reset)
        {
            Reviews.Clear();
            _currentPage = 1;
        }

        var result = await ReviewService.GetPagedReviews(ProductId, _currentPage, _pageSize);

        if (result != null)
        {
            Reviews.AddRange(result.Reviews);
            _totalCount = result.TotalCount;
        }
        else
        {
            _errorMessage = "Error loading product reviews.";
            Reviews = new List<ReviewViewModel>();
        }

        _isLoading = false;
    }

    private bool HasMore()
    {
        return Reviews.Count < _totalCount;
    }

    private async Task LoadMore()
    {
        _currentPage++;
        await LoadReviews();
    }
}
