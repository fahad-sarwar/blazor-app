@using OnlineShopUI.ViewModels
@using OnlineShopUI.Services
@inject ReviewService ReviewService

<div class="container">
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="text-center p-4">
            <p>Loading reviews...</p>
        </div>
    }
    else if (Reviews.Count > 0)
    {
        <div class="reviews-section">
            <h4 class="mb-4">Customer Reviews</h4>
            @foreach (var review in Reviews)
            {
                <div class="card mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="text-primary">@review.CustomerName</strong>
                                <div class="rating-stars mt-1">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                    }
                                    <span class="ms-2 text-muted">(@review.Rating/5)</span>
                                </div>
                            </div>
                            <span class="text-muted small">@review.GetFormattedDate()</span>
                        </div>
                        <h6 class="fw-semibold mb-2">@review.Subject</h6>
                        <p class="mb-0 text-secondary">@review.Comment</p>
                    </div>
                </div>
            }

            @if (HasMore())
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary" @onclick="LoadMore">Load More Reviews</button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-4">
            <p class="text-muted">No reviews yet. Be the first to write a review!</p>
        </div>
    }

    <AuthorizeView Context="authContext">
        <Authorized>
            <div class="review-form-section mt-5">
                @if (!_showForm)
                {
                    <div class="text-center">
                        <button class="btn btn-primary btn-lg" @onclick="() => _showForm = true">
                            Write a Review
                        </button>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Add Your Review</h5>
                        </div>
                        <div class="card-body p-4">
                            <EditForm Model="NewReview" OnValidSubmit="HandleSubmit" Context="editContext">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger mb-3" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Subject</label>
                                    <InputText class="form-control" @bind-Value="NewReview.Subject"
                                    placeholder="Brief summary of your review" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Rating</label>
                                    <div class="rating-input d-flex align-items-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            int currentStar = i;
                                            <button type="button"
                                            class="btn btn-link p-1 me-1"
                                            style="font-size: 2rem; line-height: 1;"
                                            @onclick="() => SetRating(currentStar)">
                                                <i class="bi @(currentStar <= NewReview.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary")"></i>
                                            </button>
                                        }
                                        <span class="ms-2 text-muted">(@NewReview.Rating out of 5)</span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Comment</label>
                                    <InputTextArea class="form-control" @bind-Value="NewReview.Comment" rows="4" placeholder="Share your experience with this product..." />
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">Submit Review</button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public int ProductId { get; set; }

    private List<ReviewViewModel> Reviews { get; set; } = new();
    private CreateReviewViewModel NewReview { get; set; } = new() { Rating = 5 };
    private bool _showForm = false;
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 5;
    private int _totalCount = 0;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews(reset: true);
    }

    private async Task LoadReviews(bool reset = false)
    {
        _isLoading = true;
        _errorMessage = null;

        if (reset)
        {
            Reviews.Clear();
            _currentPage = 1;
        }

        var result = await ReviewService.GetPagedReviewsAsync(ProductId, _currentPage, _pageSize);

        if (result != null)
        {
            Reviews.AddRange(result.Reviews);
            _totalCount = result.TotalCount;
        }
        else
        {
            _errorMessage = "Error loading product reviews.";
            Reviews = new List<ReviewViewModel>();
        }

        _isLoading = false;
    }

    private bool HasMore()
    {
        return Reviews.Count < _totalCount;
    }

    private async Task LoadMore()
    {
        _currentPage++;
        await LoadReviews();
    }

    private void SetRating(int rating)
    {
        NewReview.Rating = rating;
        StateHasChanged();
    }

    private void CancelForm()
    {
        _showForm = false;
        NewReview = new CreateReviewViewModel { Rating = 5 };
        _successMessage = null;
        _errorMessage = null;
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        NewReview.ProductId = ProductId;

        var success = await ReviewService.CreateReviewAsync(NewReview);

        if (success)
        {
            _showForm = false;
            NewReview = new CreateReviewViewModel { Rating = 5 };
            _successMessage = "Your review has been submitted and is pending approval.";
            await LoadReviews(reset: true);
        }
        else
        {
            _errorMessage = "Failed to submit review. Please try again.";
            _successMessage = null;
        }
    }
}
