@using OnlineShopUI.ViewModels
@rendermode InteractiveServer

<div class="card rounded-3 p-4 mb-3">
    <h5 class="mb-3">Payment Details</h5>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="cardNumber" class="form-label fw-semibold">Card Number</label>
            <InputText id="cardNumber" class="form-control" @bind-Value="CheckoutModel.CardNumber" />
            <ValidationMessage For="@(() => CheckoutModel.CardNumber)" class="text-danger" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="cardName" class="form-label fw-semibold">Cardholder Name</label>
            <InputText id="cardName" class="form-control" @bind-Value="CheckoutModel.CardName" />
            <ValidationMessage For="@(() => CheckoutModel.CardName)" class="text-danger" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="expiry" class="form-label fw-semibold">Expiry</label>
            <InputText id="expiry" class="form-control" @bind-Value="CheckoutModel.Expiry" placeholder="MM/YY" />
            <ValidationMessage For="@(() => CheckoutModel.Expiry)" class="text-danger" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="cvv" class="form-label fw-semibold">CVV</label>
            <InputText id="cvv" class="form-control" @bind-Value="CheckoutModel.CVV" placeholder="e.g. 887" />
            <ValidationMessage For="@(() => CheckoutModel.CVV)" class="text-danger" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <button type="submit" class="btn btn-success mt-3">Place Order</button>
            <a class="btn btn-outline-primary mt-3" href="/basket">Back</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public CheckoutViewModel CheckoutModel { get; set; }
}
