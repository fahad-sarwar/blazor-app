﻿@using OnlineShopUI.ViewModels

@inject NavigationManager Navigation
@using System.Security.Claims
@using OnlineShopUI.Services
@inject BasketCountService BasketCountService
@implements IDisposable
@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 sticky-top">
    <a class="navbar-brand" href="/">Bob Kart</a>

    <form class="d-flex ms-3 me-auto" @onsubmit="HandleSearch" style="width: 40%;">
        <input class="form-control me-2" @bind="SearchTerm" type="search" placeholder="Search..." />
        <button class="btn btn-outline-light" type="submit">Search</button>
    </form>

    <ul class="navbar-nav d-flex flex-row gap-3">
        <li class="nav-item">
            <NavLink class="nav-link" href="/basket">
                Basket
                <span class="badge bg-danger">@basketCount</span>
            </NavLink>
        </li>
        <AuthorizeView>
            <Authorized>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        Hello, @GetFirstName(context)
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><NavLink class="dropdown-item" href="/profile">My Profile</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/wishlist">My Wishlist</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/account/logout">Logout</NavLink></li>
                    </ul>
                </li>
            </Authorized>
            <NotAuthorized>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/account/login">Login</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/account/register">Register</NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>

</nav>

@code {
    private string SearchTerm = string.Empty;
    private int basketCount;

    protected override async Task OnInitializedAsync()
    {
        BasketCountService.OnChange += UpdateCount;
        basketCount = BasketCountService.ItemCount;
    }

    private void UpdateCount()
    {
        basketCount = BasketCountService.ItemCount;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BasketCountService.OnChange -= UpdateCount;
    }

    private Task HandleSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var encoded = Uri.EscapeDataString(SearchTerm);
            Navigation.NavigateTo($"/search-results/{encoded}");
        }

        return Task.CompletedTask;
    }

    private string GetFirstName(AuthenticationState context)
    {
        var firstNameClaim = context.User.FindFirst(ClaimTypes.GivenName);
        return !string.IsNullOrEmpty(firstNameClaim?.Value)
            ? firstNameClaim.Value
            : context.User.Identity?.Name ?? "User";
    }
}