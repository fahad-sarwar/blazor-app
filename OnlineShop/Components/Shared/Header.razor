﻿@using OnlineShopUI.ViewModels

@inject ApiAuthenticationStateProvider AuthStateProvider
@using OnlineShopUI.Services
@inject BasketCountService BasketCountService
@implements IDisposable
@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 sticky-top">
    <a class="navbar-brand" href="/">Bob Kart</a>

    <ProductSearchForm />

    <ul class="navbar-nav d-flex flex-row gap-3">
        <li class="nav-item">
            <NavLink class="nav-link" href="/basket">
                Basket
                <span class="badge bg-danger">@_basketCount</span>
            </NavLink>
        </li>
        <AuthorizeView>
            <Authorized>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        Hello, @GetFirstName(context)
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><NavLink class="dropdown-item" href="/profile">My Profile</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/orders">My Orders</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/wishlist">My Wishlist</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/account/logout">Logout</NavLink></li>
                    </ul>
                </li>
            </Authorized>
            <NotAuthorized>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/account/login">Login</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/account/register">Register</NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</nav>

@code {
    private int _basketCount;

    protected override async Task OnInitializedAsync()
    {
        BasketCountService.OnChange += UpdateCount;
        _basketCount = BasketCountService.ItemCount;
    }

    private void UpdateCount()
    {
        _basketCount = BasketCountService.ItemCount;
        StateHasChanged();
    }

    public void Dispose()
    {
        BasketCountService.OnChange -= UpdateCount;
    }

    private string GetFirstName(AuthenticationState context)
    {
        return AuthStateProvider.GetFirstname(context);
    }
}