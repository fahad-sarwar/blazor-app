@using OnlineShopUI.Services
@using OnlineShopUI.ViewModels
@inject BasketService BasketService
@inject WishlistService WishlistService
@inject CustomAuthenticationStateService CustomAuthenticationStateProvider

<div class="col">
    <div class="card h-100">
        <img src="@Product.ImageURL" class="img-fluid rounded-start" alt="@Product.Name" style="height: 200px; object-fit: cover;">
        <div class="card-body">
            <h2 class="card-title">@Product.Name</h2>
            <p class="card-text">
                @if (Product.ForSale)
                {
                    <div>
                        <p><del>Was: @Product.FormattedPrice()</del></p>
                        <p class="text-danger"><strong>Now: @Product.FormattedSalePrice()</strong></p>
                    </div>
                }
                else
                {
                <p>@Product.FormattedPrice()</p>
                }
            </p>
        </div>
        <div class="card-footer">
            <div class="d-flex gap-2">
                <a class="btn btn-primary" href="/product/@Product.Id">View</a>
                <button class="btn btn-secondary" @onclick="AddToBasket">Add to Basket</button>

                @if (CustomAuthenticationStateProvider.IsUserAuthenticated())
                {
                    @if (ShowRemoveButton.HasValue && !ShowRemoveButton.Value)
                    {
                        <button class="btn @GetWishlistButtonClass()" @onclick="AddToWishlist" disabled="@_isOnWishlist">
                            Add to Wishlist
                        </button>
                    }

                    @if (ShowRemoveButton.HasValue && ShowRemoveButton.Value)
                    {
                        <button class="btn btn-danger" @onclick="RemoveFromWishlist">Remove from Wishlist</button>
                    }
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="text-danger mt-2">@_errorMessage</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ProductViewModel Product { get; set; }
    [Parameter] public bool? ShowRemoveButton { get; set; } = false;
    [Parameter] public EventCallback<int> OnProductRemovedFromWishlist { get; set; }

    private string? _errorMessage;
    private bool _isOnWishlist;

    protected override async Task OnInitializedAsync()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged += OnAuthStateChanged;
        _isOnWishlist = await WishlistService.IsOnWishlist(Product.Id);
    }

    public void Dispose()
    {
        CustomAuthenticationStateProvider.OnUserInfoChanged -= OnAuthStateChanged;
    }

    private async Task OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddToBasket()
    {
        var result = await BasketService.AddToBasket(Product.Id, 1);

        _errorMessage = result
            ? null
            : "Failed to add item to basket. Please try again.";
    }

    private async Task AddToWishlist()
    {
        if (_isOnWishlist)
            return;

        var success = await WishlistService.AddToWishlist(Product.Id);

        if (success)
        {
            _isOnWishlist = true;
            _errorMessage = null;
        }
        else
        {
            _errorMessage = "Failed to add item to wishlist. Please try again.";
        }
    }

    private async Task RemoveFromWishlist()
    {
        var success = await WishlistService.RemoveFromWishlist(Product.Id);

        if (success)
        {
            _errorMessage = null;
            await OnProductRemovedFromWishlist.InvokeAsync(Product.Id);
        }
        else
        {
            _errorMessage = "Failed to remove product from the wishlist. Please try again.";
        }
    }

    private string GetWishlistButtonClass() => _isOnWishlist ? "btn-danger" : "btn-outline-danger";
}