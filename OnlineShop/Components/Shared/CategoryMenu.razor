
@using Api.Models
@using OnlineShopUI.Services
@inject CategoryService CategoryService
@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom px-3">
    <ul class="navbar-nav me-auto">
        @if (_categories == null)
        {
            <li class="nav-item"><span class="nav-link">Loading...</span></li>
        }
        else if (_categories.Count == 0)
        {
            <li class="nav-item"><span class="nav-link">No categories found.</span></li>
        }
        else
        {
            @foreach (var category in _categories)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="@($"categories/{category.Id}")">@category.Name</NavLink>
                </li>
            }
        }
    </ul>
</nav>

@code {
    private List<Category>? _categories;

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetCategories();
    }
}
