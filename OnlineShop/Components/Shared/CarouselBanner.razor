@rendermode InteractiveServer

<div id="carouselIndicators" class="carousel slide mb-3" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner" style="height: 400px;">
        <div class="carousel-item active">
            <img src="/images/CarouselImageOne.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
        <div class="carousel-item">
            <img src="/images/CarouselImageTwo.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
        <div class="carousel-item">
            <img src="/images/CarouselImageThree.jpg" class="d-block w-100" alt="..." style="height: 100%; object-fit: cover; width: 100%;">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
